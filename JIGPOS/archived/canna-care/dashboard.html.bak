            <!-- Tab Content: My Health -->
            <div id="tab-health" class="tab-content">
                <div class="card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title"><i data-lucide="heart-pulse" style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"></i> My Health Portal</h2>
                            <p class="card-subtitle">Access medical appointments, prescriptions, and Section 21 services</p>
                        </div>
                    </div>

                    <div style="padding: 2rem;">
                        <div style="background: var(--bg-secondary); border: 2px solid var(--bg-tertiary); border: 2px solid var(--primary-color); border-radius: 12px; padding: 2rem; margin-bottom: 2rem;">
                            <h3 style="margin-bottom: 1rem; color: var(--primary-color);">
                                <i data-lucide="hospital" style="width: 22px; height: 22px; margin-right: 8px; vertical-align: middle;"></i> Section 21 Medical Services
                            </h3>
                            <p style="color: var(--text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
                                Access our partner medical cannabis service for appointments, prescriptions, and Section 21 authorization.
                                All medical services are managed through our certified healthcare provider.
                            </p>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                                <!-- Book Appointment -->
                                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; text-align: center;">
                                    <div style="margin-bottom: 0.5rem;"><i data-lucide="calendar" style="width: 48px; height: 48px; color: var(--primary-color);"></i></div>
                                    <h4 style="margin-bottom: 0.5rem; color: var(--primary-color);">Book Appointment</h4>
                                    <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
                                        Schedule a consultation with a certified cannabis doctor
                                    </p>
                                    <button class="btn btn-primary" onclick="openMedicalPortal('appointments')" style="width: 100%;">
                                        Book Now
                                    </button>
                                </div>

                                <!-- Manage Prescriptions -->
                                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; text-align: center;">
                                    <div style="margin-bottom: 0.5rem;"><i data-lucide="clipboard-list" style="width: 48px; height: 48px; color: var(--primary-color);"></i></div>
                                    <h4 style="margin-bottom: 0.5rem; color: var(--primary-color);">My Prescriptions</h4>
                                    <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
                                        View and manage your active prescriptions
                                    </p>
                                    <button class="btn btn-secondary" onclick="openMedicalPortal('prescriptions')" style="width: 100%;">
                                        View Prescriptions
                                    </button>
                                </div>

                                <!-- Upload Section 21 -->
                                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; text-align: center;">
                                    <div style="margin-bottom: 0.5rem;"><i data-lucide="file-text" style="width: 48px; height: 48px; color: var(--primary-color);"></i></div>
                                    <h4 style="margin-bottom: 0.5rem; color: var(--primary-color);">Section 21 Letter</h4>
                                    <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
                                        Upload authorization to unlock medical products
                                    </p>
                                    <button class="btn btn-outline" onclick="switchTab('medical')" style="width: 100%;">
                                        Upload Document
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Information Section -->
                        <div style="background: rgba(74, 124, 89, 0.1); border-left: 4px solid var(--primary-color); padding: 1.5rem; border-radius: 8px;">
                            <h4 style="margin-bottom: 0.75rem; color: var(--primary-color);"><i data-lucide="info" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;"></i> How It Works</h4>
                            <ol style="margin-left: 1.5rem; color: var(--text-secondary); line-height: 1.8;">
