            <!-- Tab Content: Wellness Points -->
            <div id="tab-points" class="tab-content">
                <!-- LOYALTY POINTS MODULE - R199/MONTH - COMMENTED OUT UNTIL SUBSCRIBED
                <!-- Points Balance & Tier -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4" style="margin-bottom: 2rem;">
                    <!-- Current Balance Card -->
                    <div class="card" style="background: linear-gradient(135deg, var(--cbd-forest-green) 0%, var(--cbd-sage-green) 100%); color: white;">
                        <div style="padding: 2rem; text-align: center;">
                            <div style="opacity: 0.9; font-size: 0.875rem; margin-bottom: 0.5rem;">Your Wellness Points</div>
                            <div style="font-size: 3rem; font-weight: 700; margin-bottom: 0.5rem;" id="pointsBalance">0</div>
                            <div style="opacity: 0.9; font-size: 0.875rem;">Points Available</div>
                            <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.2);">
                                <div style="display: flex; justify-content: space-between; font-size: 0.875rem; opacity: 0.9;">
                                    <span>Points Value:</span>
                                    <span style="font-weight: 600;" id="pointsValue">R0</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current Tier Card -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title" style="font-size: 1rem;"><i data-lucide="seedling" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;"></i> Current Tier</h3>
                        </div>
                        <div style="padding: 1.5rem;">
                            <div style="text-align: center; margin-bottom: 1rem;">
                                <div style="font-size: 2rem; font-weight: 700; color: var(--cbd-forest-green); text-transform: capitalize;" id="currentTier">Seedling</div>
                                <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.5rem;" id="tierDescription">New to the garden - just starting your wellness journey</p>
                            </div>
                            <div style="background: var(--bg-tertiary); padding: 1rem; border-radius: 8px;">
                                <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem;">Progress to Next Tier</div>
                                <div class="progress" style="margin-bottom: 0.5rem;">
                                    <div class="progress-fill" id="tierProgress" style="width: 0%;"></div>
                                </div>
                                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted);">
                                    <span id="currentSpend">R0</span>
                                    <span id="nextTierSpend">R1,000</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tier Benefits Card -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title" style="font-size: 1rem;"><i data-lucide="gift" style="width: 20px; height: 20px; margin-right: 8px; vertical-align: middle;"></i> Your Benefits</h3>
                        </div>
                        <div style="padding: 1.5rem;">
                            <div id="tierBenefitsList" style="display: flex; flex-direction: column; gap: 0.75rem;">
                                <div style="display: flex; align-items: start; gap: 0.5rem;">
                                    <i data-lucide="check-circle" style="width: 16px; height: 16px; color: var(--success-color); flex-shrink: 0; margin-top: 2px;"></i>
                                    <span style="font-size: 0.875rem;">Early access to new products</span>
                                </div>
                                <div style="display: flex; align-items: start; gap: 0.5rem;">
                                    <i data-lucide="check-circle" style="width: 16px; height: 16px; color: var(--success-color); flex-shrink: 0; margin-top: 2px;"></i>
                                    <span style="font-size: 0.875rem;">Birthday bonus points</span>
                                </div>
                            </div>
                            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                    <span style="font-size: 0.875rem; color: var(--text-muted);">Points Multiplier:</span>
                                    <span style="font-weight: 600; color: var(--cbd-forest-green);" id="pointsMultiplier">1.0x</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="font-size: 0.875rem; color: var(--text-muted);">Tier Discount:</span>
                                    <span style="font-weight: 600; color: var(--cbd-forest-green);" id="tierDiscount">0%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Points History & Redemption -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                    <!-- Points History -->
                    <div class="lg:col-span-2">
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <h2 class="card-title"><i data-lucide="history" style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"></i> Points History</h2>
