# CBD Wellness 24 Environment Configuration

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/cbdwellness24

# JWT Secret for authentication
JWT_SECRET=cbdwellness24_secret_key_change_in_production

# SMTP Email Configuration
SMTP_HOST=mail.cbdwellness24.co.za
SMTP_USER=hello@cbdwellness24.co.za
SMTP_PASS=your_email_password

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Base URL
BASE_URL=http://localhost:3001

# Stripe (if needed)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Twilio (if needed for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Redis (if needed)
REDIS_URL=redis://localhost:6379