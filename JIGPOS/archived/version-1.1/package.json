{
  "name": "cbd-wellness-24",
  "version": "1.0.0",
  "description": "CBD Wellness 24 - Cannabis Wellness & Accessories E-commerce",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint backend/",
    "setup": "node backend/setup-db.js",
    "seed": "node backend/scripts/seed.js",
    "build": "echo 'No build required for static files'"
  },
  "keywords": [
    "ecommerce",
    "cannabis",
    "cbd",
    "wellness",
    "accessories"
  ],
  "author": "CBD Wellness 24",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bull": "^4.10.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.3",
    "redis": "^4.6.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^12.4.0",
    "swagger-ui-express": "^4.6.2",
    "twilio": "^4.10.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/jest": "^29.5.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "openspec": "^0.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "backend/**/*.js",
      "!backend/tests/**",
      "!backend/config/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
