<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BMH - Natural Relief, Available Anytime</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #FFFFFF;
            --secondary: #e5e5e5;
            --dark: #000000;
            --charcoal: #0a0a0a;
            --slate: #1a1a1a;
            --gray: #2a2a2a;
            --accent: #4a4a4a;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif;
            background: var(--dark);
            color: var(--primary);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* Animated gradient background */
        .gradient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: radial-gradient(ellipse at 20% 30%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),
                        radial-gradient(ellipse at 80% 70%, rgba(255, 255, 255, 0.06) 0%, transparent 50%);
            animation: meshMove 20s ease-in-out infinite;
        }

        @keyframes meshMove {
            0%, 100% { transform: scale(1) translate(0, 0); }
            50% { transform: scale(1.05) translate(3%, -3%); }
        }

        /* Floating particles */
        .particle {
            position: absolute;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            pointer-events: none;
            animation: float 15s infinite ease-in-out;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); opacity: 0; }
            10% { opacity: 0.3; }
            90% { opacity: 0.3; }
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(20px);
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #FFFFFF, #999);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Dark/Light Mode Toggle */
        .theme-toggle {
            background: linear-gradient(135deg, #FFFFFF, #e5e5e5);
            color: #000000;
            border: none;
            border-radius: 50px;
            padding: 10px 20px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .theme-toggle:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2);
        }

        body.light-mode .theme-toggle {
            background: linear-gradient(135deg, #000000, #333);
            color: #FFFFFF;
        }

        /* Light Mode Styles */
        body.light-mode {
            background: #FFFFFF;
            color: #000000;
        }

        body.light-mode .gradient-bg {
            background: radial-gradient(ellipse at 20% 30%, rgba(0, 0, 0, 0.05) 0%, transparent 50%),
                        radial-gradient(ellipse at 80% 70%, rgba(0, 0, 0, 0.03) 0%, transparent 50%);
        }

        body.light-mode nav {
            background: rgba(255, 255, 255, 0.95);
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }

        body.light-mode .logo,
        body.light-mode .nav-links a {
            background: linear-gradient(135deg, #000000, #666);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        body.light-mode .btn-primary {
            background: linear-gradient(135deg, #000000, #333);
            color: #FFFFFF;
        }

        /* Franchise button styling */
        .franchise-btn {
            background: linear-gradient(135deg, #00CED1, #008B8B) !important;
            color: #FFFFFF !important;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .franchise-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0, 206, 209, 0.3);
        }

        body.light-mode .franchise-btn {
            background: linear-gradient(135deg, #006666, #004444) !important;
            color: #FFFFFF !important;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
        }

        body.light-mode .feature-card,
        body.light-mode .product-card,
        body.light-mode .cafe-card {
            background: rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.1);
            color: #000000;
        }

        body.light-mode .feature-card p,
        body.light-mode .product-card p,
        body.light-mode .cafe-card p {
            color: #666;
        }

        body.light-mode .hero h1,
        body.light-mode .features h2,
        body.light-mode .cafes h2,
        body.light-mode .products h2,
        body.light-mode .franchise-cta h2 {
            background: linear-gradient(135deg, #000000, #666);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        body.light-mode .hero p,
        body.light-mode .products-subtitle,
        body.light-mode .franchise-cta p {
            color: #666;
        }

        body.light-mode .btn-secondary,
        body.light-mode .btn-view-menu {
            background: rgba(0, 0, 0, 0.1);
            color: #000000;
            border-color: rgba(0, 0, 0, 0.3);
        }

        body.light-mode .franchise-cta {
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.04));
            border-color: rgba(0, 0, 0, 0.2);
        }

        body.light-mode footer {
            background: #f5f5f5;
            border-top-color: rgba(0, 0, 0, 0.1);
        }

        body.light-mode .modal-content,
        body.light-mode .age-gate-content {
            background: #FFFFFF;
            color: #000000;
            border-color: rgba(0, 0, 0, 0.2);
        }

        body.light-mode .menu-item {
            border-bottom-color: rgba(0, 0, 0, 0.1);
        }

        body.light-mode .menu-item p {
            color: #666;
        }

        /* Shopping Cart Sidebar */
        .cart-sidebar {
            position: fixed;
            top: 0;
            right: -450px;
            width: 450px;
            height: 100vh;
            background: var(--slate);
            border-left: 1px solid rgba(255, 255, 255, 0.2);
            z-index: 2500;
            transition: right 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            display: flex;
            flex-direction: column;
            box-shadow: -10px 0 50px rgba(0, 0, 0, 0.5);
        }

        .cart-sidebar.active {
            right: 0;
        }

        body.light-mode .cart-sidebar {
            background: #FFFFFF;
            border-left-color: rgba(0, 0, 0, 0.2);
        }

        .cart-header {
            padding: 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        body.light-mode .cart-header {
            border-bottom-color: rgba(0, 0, 0, 0.1);
        }

        .cart-items {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        .cart-item {
            display: flex;
            gap: 15px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }

        .cart-item:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        body.light-mode .cart-item {
            background: rgba(0, 0, 0, 0.05);
        }

        body.light-mode .cart-item:hover {
            background: rgba(0, 0, 0, 0.1);
        }

        .cart-item-image {
            width: 80px;
            height: 80px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }

        .cart-item-details {
            flex: 1;
        }

        .cart-item-remove {
            background: rgba(255, 0, 0, 0.2);
            border: none;
            color: #ff4444;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s;
        }

        .cart-item-remove:hover {
            background: rgba(255, 0, 0, 0.4);
        }

        .cart-footer {
            padding: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        body.light-mode .cart-footer {
            border-top-color: rgba(0, 0, 0, 0.1);
        }

        .cart-total {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: linear-gradient(135deg, #ff4444, #cc0000);
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
        }

        .cart-icon-wrapper {
            position: relative;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .cart-icon-wrapper:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* Product Detail Modal */
        .product-detail-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(10px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            padding: 20px;
            animation: fadeIn 0.3s ease-out;
        }

        .product-detail-modal.active {
            display: flex;
        }

        .product-detail-content {
            background: var(--slate);
            border-radius: 30px;
            max-width: 1000px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid rgba(255, 255, 255, 0.2);
            position: relative;
            animation: slideUp 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        body.light-mode .product-detail-content {
            background: #FFFFFF;
            border-color: rgba(0, 0, 0, 0.2);
        }

        .product-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            padding: 50px;
        }

        .product-detail-image {
            width: 100%;
            aspect-ratio: 1;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 120px;
        }

        body.light-mode .product-detail-image {
            background: rgba(0, 0, 0, 0.05);
        }

        .product-detail-info h2 {
            font-size: 36px;
            margin-bottom: 15px;
        }

        .product-detail-price {
            font-size: 32px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 20px;
        }

        .product-detail-description {
            color: var(--secondary);
            line-height: 1.8;
            margin-bottom: 30px;
        }

        body.light-mode .product-detail-description {
            color: #666;
        }

        .product-specs {
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        body.light-mode .product-specs {
            background: rgba(0, 0, 0, 0.05);
        }

        .product-spec-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        body.light-mode .product-spec-item {
            border-bottom-color: rgba(0, 0, 0, 0.1);
        }

        .product-spec-item:last-child {
            border-bottom: none;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .quantity-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary);
            font-size: 20px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .quantity-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.6);
        }

        body.light-mode .quantity-btn {
            border-color: rgba(0, 0, 0, 0.3);
            background: rgba(0, 0, 0, 0.05);
            color: #000000;
        }

        .quantity-input {
            width: 60px;
            height: 40px;
            text-align: center;
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.05);
            color: var(--primary);
            font-size: 18px;
            font-weight: 600;
        }

        body.light-mode .quantity-input {
            border-color: rgba(0, 0, 0, 0.3);
            background: rgba(0, 0, 0, 0.05);
            color: #000000;
        }

        @media (max-width: 768px) {
            .cart-sidebar {
                width: 100%;
                right: -100%;
            }

            .product-detail-grid {
                grid-template-columns: 1fr;
                padding: 30px;
            }
        }

        .nav-links {
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: var(--secondary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s;
            position: relative;
        }

        .nav-links a:hover {
            color: var(--primary);
            transform: translateY(-2px);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--primary);
            transition: width 0.3s;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, #FFFFFF, #e5e5e5);
            color: #000000 !important;
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255, 255, 255, 0.2);
        }

        body.light-mode .btn-primary {
            background: linear-gradient(135deg, #000000, #333333);
            color: #FFFFFF !important;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 5% 60px;
            position: relative;
        }

        .logo-placeholder {
            width: 300px;
            height: 300px;
            margin: 0 auto 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: logoPulse 3s ease-in-out infinite;
            background: transparent;
        }

        .logo-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 10px 30px rgba(255, 255, 255, 0.2));
        }

        body.light-mode .logo-placeholder img {
            filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.2));
        }

        /* Logo switching for dark/light mode */
        /* In dark mode (default): show white logo */
        .logo-for-dark {
            display: block;
        }

        .logo-for-light {
            display: none;
        }

        /* In light mode: show black logo */
        body.light-mode .logo-for-dark {
            display: none;
        }

        body.light-mode .logo-for-light {
            display: block;
        }

        @keyframes logoPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .hero h1 {
            font-size: 72px;
            font-weight: 800;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #FFFFFF, #999);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -2px;
            animation: fadeInUp 1s ease-out;
        }

        .hero p {
            font-size: 24px;
            color: var(--secondary);
            margin-bottom: 40px;
            animation: fadeInUp 1s ease-out 0.2s backwards;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            animation: fadeInUp 1s ease-out 0.4s backwards;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary);
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.6);
            transform: translateY(-3px);
        }

        /* Franchise CTA Section */
        .franchise-cta {
            padding: 80px 5%;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            margin: 60px 5%;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .franchise-cta::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.05), transparent);
            animation: shine 3s infinite;
        }

        @keyframes shine {
            0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
            100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
        }

        .franchise-cta h2 {
            font-size: 48px;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #FFFFFF, #e5e5e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            position: relative;
            z-index: 1;
        }

        .franchise-cta p {
            font-size: 20px;
            color: var(--secondary);
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
        }

        .franchise-badge {
            display: inline-block;
            background: linear-gradient(135deg, #00CED1, #008B8B);
            color: #FFFFFF;
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        /* Features Grid */
        .features {
            padding: 80px 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .features h2 {
            text-align: center;
            font-size: 48px;
            margin-bottom: 60px;
            background: linear-gradient(135deg, #FFFFFF, #999);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 40px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s;
            cursor: pointer;
        }

        .feature-card:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-10px);
            box-shadow: 0 20px 60px rgba(255, 255, 255, 0.1);
        }

        .feature-icon {
            font-size: 48px;
            margin-bottom: 20px;
            color: var(--primary);
            transition: all 0.3s;
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.1);
        }

        body.light-mode .feature-icon {
            color: #000000;
        }

        .feature-card h3 {
            font-size: 24px;
            margin-bottom: 15px;
        }

        .feature-card p {
            color: var(--secondary);
            font-size: 16px;
        }

        /* Café Section */
        .cafes {
            padding: 80px 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .cafes h2 {
            text-align: center;
            font-size: 48px;
            margin-bottom: 60px;
            background: linear-gradient(135deg, #FFFFFF, #999);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .cafe-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
        }

        .cafe-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            padding: 50px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-align: center;
            transition: all 0.4s;
            cursor: pointer;
        }

        .cafe-card:hover {
            transform: scale(1.05);
            box-shadow: 0 30px 80px rgba(255, 255, 255, 0.15);
        }

        .cafe-card img {
            transition: all 0.3s;
        }

        body.light-mode .cafe-card img {
            filter: invert(0) !important;
        }

        .cafe-card h3 {
            font-size: 32px;
            margin-bottom: 15px;
        }

        .cafe-card p {
            color: var(--secondary);
            margin-bottom: 25px;
            font-size: 16px;
        }

        .btn-view-menu {
            display: inline-block;
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary);
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .btn-view-menu:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.6);
        }

        /* Product Carousel */
        .products {
            padding: 80px 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .products h2 {
            text-align: center;
            font-size: 48px;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #FFFFFF, #999);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .products-subtitle {
            text-align: center;
            color: var(--secondary);
            margin-bottom: 60px;
            font-size: 18px;
        }

        .product-carousel {
            display: flex;
            overflow-x: auto;
            gap: 30px;
            padding: 20px 0;
            scroll-snap-type: x mandatory;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
        }

        .product-carousel::-webkit-scrollbar {
            height: 8px;
        }

        .product-carousel::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .product-carousel::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }

        .product-card {
            min-width: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s;
            scroll-snap-align: start;
            cursor: pointer;
        }

        .product-card:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-10px);
            box-shadow: 0 20px 60px rgba(255, 255, 255, 0.1);
        }

        .product-image {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
            border-radius: 15px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 64px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

        .product-image::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(10%, 10%); }
        }

        .product-image img {
            position: relative;
            z-index: 1;
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image img {
            transform: scale(1.1) rotate(5deg);
        }

        body.light-mode .product-image {
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.02));
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

        body.light-mode .product-image::before {
            background: radial-gradient(circle, rgba(0, 0, 0, 0.03) 0%, transparent 70%);
        }

        .product-card h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .product-card p {
            color: var(--secondary);
            font-size: 14px;
            margin-bottom: 15px;
        }

        .product-price {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 20px;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(10px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--slate);
            padding: 50px;
            border-radius: 30px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid rgba(255, 255, 255, 0.2);
            position: relative;
            animation: modalSlideIn 0.3s ease-out;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: var(--primary);
            font-size: 32px;
            cursor: pointer;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(90deg);
        }

        .menu-item {
            display: flex;
            justify-content: space-between;
            padding: 20px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .menu-item h4 {
            font-size: 18px;
            margin-bottom: 5px;
        }

        .menu-item p {
            color: var(--secondary);
            font-size: 14px;
        }

        .menu-price {
            font-weight: 700;
            font-size: 20px;
        }

        /* Age Gate */
        .age-gate {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.98);
            backdrop-filter: blur(20px);
            z-index: 3000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .age-gate-content {
            background: var(--slate);
            padding: 60px;
            border-radius: 30px;
            text-align: center;
            max-width: 600px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .age-gate h2 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        .age-gate p {
            color: var(--secondary);
            margin-bottom: 40px;
            font-size: 18px;
        }

        .age-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .btn-yes {
            background: linear-gradient(135deg, #FFFFFF, #e5e5e5);
            color: var(--dark);
            padding: 15px 40px;
            border-radius: 50px;
            border: none;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-yes:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255, 255, 255, 0.2);
        }

        .btn-no {
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary);
            padding: 15px 40px;
            border-radius: 50px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-no:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Footer */
        footer {
            background: var(--charcoal);
            padding: 60px 5% 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 80px;
        }

        .footer-content {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-section h3 {
            font-size: 20px;
            margin-bottom: 20px;
        }

        .footer-section a {
            display: block;
            color: var(--secondary);
            text-decoration: none;
            margin-bottom: 10px;
            transition: all 0.3s;
        }

        .footer-section a:hover {
            color: var(--primary);
            transform: translateX(5px);
        }

        .footer-bottom {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--secondary);
        }

        /* Tablet/Medium screens */
        @media (max-width: 1100px) {
            .nav-links {
                gap: 15px;
            }

            .nav-links a,
            .nav-links .btn-primary,
            .nav-links .franchise-btn {
                font-size: 13px;
                padding: 10px 18px;
            }
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            nav {
                flex-direction: column;
                gap: 15px;
                padding: 15px 5%;
            }

            .nav-links {
                gap: 12px;
                flex-wrap: wrap;
                justify-content: center;
                width: 100%;
            }

            .nav-links a,
            .nav-links .btn-primary,
            .nav-links .franchise-btn {
                font-size: 13px;
                padding: 10px 20px;
                white-space: nowrap;
            }

            .nav-links .theme-toggle {
                padding: 8px 16px;
                font-size: 12px;
            }

            .hero h1 {
                font-size: 42px;
            }

            .hero p {
                font-size: 18px;
            }

            .logo-placeholder {
                width: 150px;
                height: 150px;
            }

            .franchise-cta h2,
            .features h2,
            .cafes h2,
            .products h2 {
                font-size: 32px;
            }

            .feature-card,
            .cafe-card {
                padding: 30px;
            }

            .modal-content {
                padding: 30px;
            }

            .age-gate-content {
                padding: 40px 30px;
            }

            .age-buttons {
                flex-direction: column;
            }
        }

        @media (max-width: 480px) {
            .hero h1 {
                font-size: 32px;
            }

            .btn-primary,
            .btn-secondary {
                padding: 10px 20px;
                font-size: 14px;
            }

            .product-card {
                min-width: 250px;
            }
        }
    </style>
</head>
<body>
    <!-- Age Gate -->
    <div class="age-gate" id="ageGate">
        <div class="age-gate-content">
            <h2>Age Verification Required</h2>
            <p>You must be 18 years or older to access this website.<br>Are you 18 or older?</p>
            <div class="age-buttons">
                <button class="btn-yes" onclick="verifyAge(true)">Yes, I'm 18+</button>
                <button class="btn-no" onclick="verifyAge(false)">No, I'm under 18</button>
            </div>
        </div>
    </div>

    <!-- Animated Background -->
    <div class="gradient-bg"></div>

    <!-- Navigation -->
    <nav>
        <div class="logo-container">
            <div class="logo">BMH</div>
        </div>
        <div class="nav-links">
            <a href="index.html">Home</a>
            <a href="about.html">About</a>
            <a href="locations.html">Locations</a>
            <a href="contact.html">Contact</a>
            <a href="products.html">Shop</a>
            <button class="theme-toggle" onclick="toggleTheme()" id="themeToggle">
                <span id="themeIcon">🌙</span>
                <span id="themeText">Dark</span>
            </button>
            <div class="cart-icon-wrapper" onclick="toggleCart()">
                <i class="fas fa-shopping-cart" style="font-size: 20px;"></i>
                <span class="cart-badge" id="cartBadge" style="display: none;">0</span>
            </div>
            <a href="/login" class="btn-primary">Login / Sign Up</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div>
            <div class="logo-placeholder">
                <img src="/images/logo-w.png" alt="BMH Logo" class="logo-for-dark">
                <img src="/images/logo-d.png" alt="BMH Logo" class="logo-for-light">
            </div>
            <h1>Welcome to the Future<br>of Wellness</h1>
            <p>Premium CBD products and medical cannabis solutions</p>
            <div class="hero-buttons">
                <a href="/login" class="btn-primary">Get Started</a>
                <a href="#products" class="btn-secondary">Explore Products</a>
            </div>
        </div>
    </section>

    <!-- Franchise CTA -->
    <section class="franchise-cta" id="franchise">
        <span class="franchise-badge"><i class="fas fa-briefcase"></i> EXCLUSIVE OPPORTUNITY</span>
        <h2>Join Our Franchise Network</h2>
        <p>Become part of South Africa's leading CBD wellness franchise.<br>Premium locations, comprehensive training, and proven success model.</p>
        <div style="display: flex; gap: 15px; justify-content: center; margin-top: 30px; flex-wrap: wrap;">
            <button class="btn-primary" onclick="openFranchiseModal()" style="border: none;">Apply Now</button>
            <a href="mailto:hello@basothomedicalherbs.ls" class="btn-secondary">Email Us</a>
        </div>
    </section>

    <!-- Features Grid -->
    <section class="features">
        <h2>Why Choose Us</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                <h3>Medical Compliant</h3>
                <p>Fully compliant with South African medical cannabis regulations. Safe, legal, and verified.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="fas fa-leaf"></i></div>
                <h3>Premium Quality</h3>
                <p>Lab-tested CBD and medical-grade cannabis products. Only the highest standards.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="fas fa-clock"></i></div>
                <h3>24-Hour Accessibility Drive-Through</h3>
                <p>Convenient 24/7 access to our drive-through service. Your wellness, your schedule.</p>
            </div>
        </div>
    </section>

    <!-- Cafés Section -->
    <section class="cafes" id="cafes">
        <h2>Visit Our Cafés</h2>
        <div class="cafe-grid">
            <div class="cafe-card" onclick="openCafeMenu('brewha')">
                <div style="margin-bottom: 20px;">
                    <img src="/images/weedicons/lb.png" alt="La Brewha" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);">
                </div>
                <h3>La Brewha</h3>
                <p>Artisan coffee, specialty drinks, and CBD-infused treats in a relaxed atmosphere.</p>
                <button class="btn-view-menu">View Menu</button>
            </div>
            <div class="cafe-card" onclick="openCafeMenu('beanBud')">
                <div style="margin-bottom: 20px;">
                    <img src="/images/weedicons/bb.png" alt="Bean & Bud" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);">
                </div>
                <h3>Bean & Bud</h3>
                <p>Coffee culture meets wellness. Premium CBD products and gourmet beverages.</p>
                <button class="btn-view-menu">View Menu</button>
            </div>
        </div>
    </section>

    <!-- Products Carousel -->
    <section class="products" id="products">
        <h2>Featured Accessories</h2>
        <p class="products-subtitle">Premium accessories for your wellness journey (No prescription required)</p>
        <div class="product-carousel" id="productCarousel">
            <div class="product-card">
                <div class="product-image">🧪</div>
                <h3>Loading products...</h3>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>BMH</h3>
                <p style="color: var(--secondary);">Premium CBD and medical cannabis solutions across South Africa.</p>
            </div>
            <div class="footer-section">
                <h3>Quick Links</h3>
                <a href="#home">Home</a>
                <a href="/login">Login</a>
                <a href="#products">Shop</a>
                <a href="#cafes">Cafés</a>
            </div>
            <div class="footer-section">
                <h3>Support</h3>
                <a href="mailto:hello@basothomedicalherbs.ls">Contact Us</a>
                <a href="/privacy-policy.html">Privacy Policy</a>
                <a href="/terms-of-service.html">Terms of Service</a>
                <a href="/section21-info.html">Section 21 Info</a>
            </div>
            <div class="footer-section">
                <h3>Business</h3>
                <a href="mailto:hello@basothomedicalherbs.ls?subject=Franchise%20Opportunity%20Inquiry%20-%20CBD%20Wellness%2024&body=Dear%20CBD%20Wellness%2024%20Team%2C%0D%0A%0D%0AI%20am%20interested%20in%20learning%20more%20about%20your%20franchise%20opportunities.%20Please%20provide%20me%20with%20information%20about%3A%0D%0A%0D%0A-%20Franchise%20requirements%20and%20qualifications%0D%0A-%20Initial%20investment%20and%20ongoing%20costs%0D%0A-%20Training%20and%20support%20provided%0D%0A-%20Available%20territories%2Flocations%0D%0A-%20Expected%20timeline%20and%20next%20steps%0D%0A%0D%0AThank%20you%20for%20your%20time.%0D%0A%0D%0ABest%20regards%2C">Franchise Opportunities</a>
                <a href="#">Wholesale</a>
                <a href="#">Partnerships</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2024 BMH. All rights reserved. | 18+ Only</p>
        </div>
    </footer>

    <!-- La Brewha Menu Modal -->
    <div class="modal" id="brewhaModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('brewhaModal')">&times;</button>
            <h2 style="margin-bottom: 30px;">La Brewha Menu</h2>
            <div id="brewhaMenuItems" style="display: grid; gap: 20px;">
                <div style="text-align: center; padding: 40px; color: #999;">
                    Loading menu...
                </div>
            </div>
        </div>
    </div>

    <!-- Bean & Bud Menu Modal -->
    <div class="modal" id="beanBudModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('beanBudModal')">&times;</button>
            <h2 style="margin-bottom: 30px;"><i class="fas fa-seedling"></i> Bean & Bud Menu</h2>
            <div id="beanBudMenuItems" style="display: grid; gap: 20px;">
                <div style="text-align: center; padding: 40px; color: #999;">
                    Loading menu...
                </div>
            </div>
        </div>
    </div>

    <!-- Shopping Cart Sidebar -->
    <div class="cart-sidebar" id="cartSidebar">
        <div class="cart-header">
            <h2><i class="fas fa-shopping-cart"></i> Shopping Cart</h2>
            <button class="modal-close" onclick="toggleCart()" style="position: static; margin: 0;">&times;</button>
        </div>
        <div class="cart-items" id="cartItemsContainer">
            <p style="text-align: center; color: var(--secondary); padding: 40px;">Your cart is empty</p>
        </div>
        <div class="cart-footer">
            <div class="cart-total">
                <span>Total:</span>
                <span id="cartTotal">R0.00</span>
            </div>
            <button class="btn-primary" style="width: 100%; padding: 16px; font-size: 16px; border: none;" onclick="proceedToCheckout()">
                Proceed to Checkout
            </button>
        </div>
    </div>

    <!-- Product Detail Modal -->
    <div class="product-detail-modal" id="productDetailModal">
        <div class="product-detail-content">
            <button class="modal-close" onclick="closeProductDetail()">&times;</button>
            <div class="product-detail-grid">
                <div>
                    <div class="product-detail-image" id="productDetailImage">
                        <i class="fas fa-box"></i>
                    </div>
                </div>
                <div class="product-detail-info">
                    <h2 id="productDetailName">Product Name</h2>
                    <div class="product-detail-price" id="productDetailPrice">R0.00</div>
                    <p class="product-detail-description" id="productDetailDescription">Product description goes here...</p>

                    <div class="product-specs">
                        <h3 style="margin-bottom: 15px;">Product Details</h3>
                        <div id="productDetailSpecs"></div>
                    </div>

                    <div class="quantity-selector">
                        <span style="font-weight: 600;">Quantity:</span>
                        <button class="quantity-btn" onclick="decreaseQuantity()">-</button>
                        <input type="number" class="quantity-input" id="productQuantity" value="1" min="1" max="99" readonly>
                        <button class="quantity-btn" onclick="increaseQuantity()">+</button>
                    </div>

                    <button class="btn-primary" style="width: 100%; padding: 16px; font-size: 16px; border: none;" onclick="addToCart()">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Franchise Onboarding Modal -->
    <div class="modal" id="franchiseModal">
        <div class="modal-content" style="max-width: 900px;">
            <button class="modal-close" onclick="closeModal('franchiseModal')">&times;</button>
            <h2 style="margin-bottom: 15px; text-align: center;"><i class="fas fa-briefcase"></i> Franchise Application</h2>
            <p style="text-align: center; color: var(--secondary); margin-bottom: 40px;">Join South Africa's fastest-growing CBD wellness brand</p>

            <form id="franchiseForm" style="display: grid; gap: 20px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">First Name *</label>
                        <input type="text" name="firstName" required style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Last Name *</label>
                        <input type="text" name="lastName" required style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Email Address *</label>
                        <input type="email" name="email" required style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Phone Number *</label>
                        <input type="tel" name="phone" required style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px;">
                    </div>
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Preferred Location/City *</label>
                    <input type="text" name="location" required style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px;">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Investment Budget *</label>
                        <select name="budget" required style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px;">
                            <option value="">Select budget range</option>
                            <option value="500k-1m">R500k - R1M</option>
                            <option value="1m-2m">R1M - R2M</option>
                            <option value="2m-5m">R2M - R5M</option>
                            <option value="5m+">R5M+</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Business Experience *</label>
                        <select name="experience" required style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px;">
                            <option value="">Select experience</option>
                            <option value="none">No business experience</option>
                            <option value="1-5">1-5 years</option>
                            <option value="5-10">5-10 years</option>
                            <option value="10+">10+ years</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Why do you want to join our franchise? *</label>
                    <textarea name="message" required rows="4" style="width: 100%; padding: 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); color: var(--primary); font-size: 16px; resize: vertical;"></textarea>
                </div>

                <div style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="franchiseTerms" required style="width: 20px; height: 20px;">
                    <label for="franchiseTerms" style="font-size: 14px;">I agree to be contacted about franchise opportunities and understand this is not a binding agreement.</label>
                </div>

                <button type="submit" class="btn-primary" style="width: 100%; padding: 16px; font-size: 16px; border: none;">Submit Application</button>
            </form>

            <div id="franchiseSuccess" style="display: none; text-align: center; padding: 40px;">
                <h3 style="font-size: 32px; margin-bottom: 15px;">✅ Application Received!</h3>
                <p style="color: var(--secondary);">Thank you for your interest. Our franchise team will contact you within 48 hours.</p>
                <button onclick="closeModal('franchiseModal')" class="btn-primary" style="margin-top: 20px; border: none;">Close</button>
            </div>
        </div>
    </div>

    <script>
        // Age Gate Verification
        function verifyAge(isOver18) {
            if (isOver18) {
                sessionStorage.setItem('ageVerified', 'true');
                document.getElementById('ageGate').style.display = 'none';
            } else {
                // Redirect immediately without alert
                window.location.href = 'https://www.google.com';
            }
        }

        // Check age verification on load
        window.addEventListener('DOMContentLoaded', () => {
            if (sessionStorage.getItem('ageVerified') === 'true') {
                document.getElementById('ageGate').style.display = 'none';
            }

            // Generate floating particles
            for (let i = 0; i < 20; i++) {
                createParticle();
            }

            // Load cart and products
            loadCart();
            loadProducts();
        });

        function createParticle() {
            const particle = document.createElement('div');
            particle.className = 'particle';
            const size = Math.random() * 100 + 50;
            particle.style.width = size + 'px';
            particle.style.height = size + 'px';
            particle.style.left = Math.random() * 100 + '%';
            particle.style.top = Math.random() * 100 + '%';
            particle.style.animationDelay = Math.random() * 15 + 's';
            particle.style.animationDuration = (Math.random() * 10 + 15) + 's';
            document.querySelector('.gradient-bg').appendChild(particle);
        }

        // Shopping Cart State
        let cart = [];
        let currentProduct = null;

        // Load cart from localStorage
        function loadCart() {
            const savedCart = localStorage.getItem('bmh_cart');
            if (savedCart) {
                cart = JSON.parse(savedCart);
                updateCartUI();
            }
        }

        function saveCart() {
            localStorage.setItem('bmh_cart', JSON.stringify(cart));
        }

        function updateCartUI() {
            const cartBadge = document.getElementById('cartBadge');
            const cartItemsContainer = document.getElementById('cartItemsContainer');
            const cartTotal = document.getElementById('cartTotal');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);

            if (totalItems > 0) {
                cartBadge.style.display = 'flex';
                cartBadge.textContent = totalItems;
            } else {
                cartBadge.style.display = 'none';
            }

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = '<p style="text-align: center; color: var(--secondary); padding: 40px;">Your cart is empty</p>';
                cartTotal.textContent = 'R0.00';
            } else {
                const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                cartTotal.textContent = `R${total.toFixed(2)}`;

                cartItemsContainer.innerHTML = cart.map(item => `
                    <div class="cart-item">
                        <div class="cart-item-image">
                            ${getProductIcon(item)}
                        </div>
                        <div class="cart-item-details">
                            <h4 style="margin-bottom: 5px;">${item.name}</h4>
                            <p style="color: var(--secondary); font-size: 14px; margin-bottom: 5px;">Qty: ${item.quantity}</p>
                            <p style="font-weight: 700;">R${(item.price * item.quantity).toFixed(2)}</p>
                        </div>
                        <button class="cart-item-remove" onclick="removeFromCart('${item._id}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `).join('');
            }
        }

        function toggleCart() {
            document.getElementById('cartSidebar').classList.toggle('active');
        }

        function addToCart() {
            if (!currentProduct) return;

            const quantity = parseInt(document.getElementById('productQuantity').value);
            const existingItem = cart.find(item => item._id === currentProduct._id);

            if (existingItem) {
                existingItem.quantity += quantity;
            } else {
                cart.push({
                    _id: currentProduct._id,
                    name: currentProduct.name,
                    price: currentProduct.price,
                    quantity: quantity
                });
            }

            saveCart();
            updateCartUI();
            closeProductDetail();
            toggleCart();
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item._id !== productId);
            saveCart();
            updateCartUI();
        }

        function proceedToCheckout() {
            if (cart.length === 0) return;
            window.location.href = '/login?redirect=checkout';
        }

        // Product Detail Functions
        function openProductDetail(product) {
            currentProduct = product;
            document.getElementById('productDetailName').textContent = product.name;
            document.getElementById('productDetailPrice').textContent = `R${product.price.toFixed(2)}`;
            document.getElementById('productDetailDescription').textContent = product.description;
            document.getElementById('productDetailImage').innerHTML = getProductIcon(product);
            document.getElementById('productQuantity').value = 1;

            // Add product specs
            const specsContainer = document.getElementById('productDetailSpecs');
            let specsHTML = '';

            if (product.sku) {
                specsHTML += `<div class="product-spec-item"><span>SKU:</span><span>${product.sku}</span></div>`;
            }
            if (product.category) {
                specsHTML += `<div class="product-spec-item"><span>Category:</span><span>${product.category}</span></div>`;
            }
            if (product.inventory && product.inventory.quantity) {
                specsHTML += `<div class="product-spec-item"><span>In Stock:</span><span>${product.inventory.quantity} units</span></div>`;
            }

            specsContainer.innerHTML = specsHTML;

            document.getElementById('productDetailModal').classList.add('active');
        }

        function closeProductDetail() {
            document.getElementById('productDetailModal').classList.remove('active');
            currentProduct = null;
        }

        function increaseQuantity() {
            const input = document.getElementById('productQuantity');
            const current = parseInt(input.value);
            if (current < 99) {
                input.value = current + 1;
            }
        }

        function decreaseQuantity() {
            const input = document.getElementById('productQuantity');
            const current = parseInt(input.value);
            if (current > 1) {
                input.value = current - 1;
            }
        }

        // Get appropriate icon for product
        function getProductIcon(product) {
            const name = product.name.toLowerCase();
            const desc = (product.description || '').toLowerCase();
            const category = (product.category || '').toLowerCase();
            const isLightMode = document.body.classList.contains('light-mode');

            // Map products to cannabis/wellness icons
            if (name.includes('grinder') || desc.includes('grinder')) {
                const grinderImg = isLightMode ? '/images/grinderd.png' : '/images/grinderw.png';
                return `<img src="${grinderImg}" class="product-icon-grinder" style="width: 80px; height: 80px; object-fit: contain;" alt="Grinder">`;
            } else if (name.includes('pipe') || name.includes('bong') || desc.includes('pipe') || desc.includes('bong')) {
                return '<img src="/images/weedicons/bong.png" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);" alt="Pipe">';
            } else if (name.includes('joint') || name.includes('paper') || name.includes('rolling')) {
                return '<img src="/images/weedicons/joint.png" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);" alt="Rolling">';
            } else if (name.includes('oil') || name.includes('cbd') || desc.includes('cbd')) {
                return '<img src="/images/weedicons/cannabis-oil.png" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);" alt="CBD">';
            } else if (name.includes('cannabis') || name.includes('flower') || name.includes('bud')) {
                return '<img src="/images/weedicons/cannabis.png" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);" alt="Cannabis">';
            } else if (name.includes('medical') || category.includes('medical')) {
                return '<img src="/images/weedicons/medical.png" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);" alt="Medical">';
            } else if (name.includes('legal') || name.includes('section')) {
                return '<img src="/images/weedicons/legal.png" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);" alt="Legal">';
            } else {
                // Default to cannabis leaf icon
                return '<img src="/images/weedicons/cannabis.png" style="width: 80px; height: 80px; object-fit: contain; filter: invert(1);" alt="Product">';
            }
        }

        // Load Products (public accessories only)
        async function loadProducts() {
            try {
                const API_URL = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
                    ? 'http://localhost:3001/api/v1'
                    : `${window.location.protocol}//${window.location.host}/api/v1`;
                const response = await fetch(`${API_URL}/products`);
                const data = await response.json();

                if (data.success && data.products.length > 0) {
                    const carousel = document.getElementById('productCarousel');
                    carousel.innerHTML = '';

                    // Index page: ONLY show accessories and merchandise
                    // NO cannabis products, NO CBD, NO medical - just accessories & merch
                    const accessoryCategories = ['accessories', 'glassware', 'vaporizers', 'merchandise'];

                    const displayProducts = data.products.filter(product => {
                        // ONLY accessories category allowed on index page
                        if (!accessoryCategories.includes(product.category)) return false;

                        // Hide Section 21 products
                        if (product.section21Required) return false;

                        // Hide any cannabis/flower products
                        const isCannabis = product.category === 'flower' ||
                                         product.category === 'cannabis' ||
                                         product.category === 'medical-cannabis' ||
                                         product.name.toLowerCase().includes('cannabis') ||
                                         product.name.toLowerCase().includes('flower') ||
                                         product.name.toLowerCase().includes('cbd');
                        if (isCannabis) return false;

                        return true;
                    });

                    displayProducts.forEach(product => {
                        const card = document.createElement('div');
                        card.className = 'product-card';
                        card.onclick = () => openProductDetail(product);
                        card.innerHTML = `
                            <div class="product-image">${getProductIcon(product)}</div>
                            <h3>${product.name}</h3>
                            <p>${product.shortDescription || product.description.substring(0, 80) + '...'}</p>
                            <div class="product-price">R${product.price.toFixed(2)}</div>
                            <button class="btn-secondary" style="width: 100%;">View Details</button>
                        `;
                        carousel.appendChild(card);
                    });
                }
            } catch (error) {
                console.error('Error loading products:', error);
            }
        }

        // Café Menu Modals
        async function openCafeMenu(cafe) {
            if (cafe === 'brewha') {
                document.getElementById('brewhaModal').classList.add('active');
                await loadCafeMenu('la-brewha', 'brewhaMenuItems');
            } else if (cafe === 'beanBud') {
                document.getElementById('beanBudModal').classList.add('active');
                await loadCafeMenu('bean-and-bud', 'beanBudMenuItems');
            }
        }

        async function loadCafeMenu(venue, containerId) {
            try {
                const API_URL = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
                    ? 'http://localhost:3001/api/v1'
                    : `${window.location.protocol}//${window.location.host}/api/v1`;
                const response = await fetch(`${API_URL}/menu/venue/${venue}`);
                const data = await response.json();

                if (data.success && data.menuItems) {
                    displayMenuItems(data.menuItems, containerId);
                } else {
                    document.getElementById(containerId).innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #999;">
                            No menu items available
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading menu:', error);
                document.getElementById(containerId).innerHTML = `
                    <div style="text-align: center; padding: 40px; color: #f44336;">
                        Error loading menu
                    </div>
                `;
            }
        }

        function displayMenuItems(items, containerId) {
            const container = document.getElementById(containerId);

            if (!items || items.length === 0) {
                container.innerHTML = '<div style="text-align: center; padding: 40px; color: #999;">No menu items available</div>';
                return;
            }

            container.innerHTML = items.map(item => `
                <div class="menu-item" style="border: 1px solid #333; border-radius: 8px; padding: 16px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="flex: 1;">
                        <h4 style="margin: 0 0 8px 0; color: var(--primary);">${item.name}</h4>
                        <p style="margin: 0; color: #999; font-size: 0.9rem;">${item.description}</p>
                        ${item.cbdInfused ? '<span style="display: inline-block; margin-top: 8px; padding: 4px 8px; background: var(--cbd-sage-green); color: white; border-radius: 4px; font-size: 0.75rem;">CBD Infused</span>' : ''}
                    </div>
                    <div style="text-align: right; margin-left: 16px;">
                        <div class="menu-price" style="font-size: 1.2rem; font-weight: 700; color: var(--primary); margin-bottom: 8px;">
                            R${item.price.toFixed(2)}
                        </div>
                        <button
                            class="btn-primary"
                            style="padding: 8px 16px; font-size: 0.9rem; white-space: nowrap;"
                            onclick='addMenuItemToCart(${JSON.stringify(item)})'
                        >
                            <i class="fas fa-plus"></i> Add
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function addMenuItemToCart(item) {
            const cartItem = {
                _id: item._id,
                name: item.name,
                price: item.price,
                category: 'coffee',
                quantity: 1,
                type: 'menu-item'
            };

            const existing = cart.find(c => c._id === item._id && c.type === 'menu-item');
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push(cartItem);
            }

            updateCartUI();
            toggleCart(); // Open cart sidebar to show added item
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        // Close modal on outside click
        window.addEventListener('click', (e) => {
            if (e.target.classList.contains('modal')) {
                e.target.classList.remove('active');
            }
        });

        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Theme Toggle
        function toggleTheme() {
            const body = document.body;
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');

            body.classList.toggle('light-mode');

            if (body.classList.contains('light-mode')) {
                themeIcon.textContent = '☀️';
                themeText.textContent = 'Light';
                localStorage.setItem('theme', 'light');
            } else {
                themeIcon.textContent = '🌙';
                themeText.textContent = 'Dark';
                localStorage.setItem('theme', 'dark');
            }
        }

        // Load saved theme on page load
        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'light') {
                document.body.classList.add('light-mode');
                document.getElementById('themeIcon').textContent = '☀️';
                document.getElementById('themeText').textContent = 'Light';
            }
        });

        // Franchise Modal
        function openFranchiseModal() {
            document.getElementById('franchiseModal').classList.add('active');
        }

        // Franchise Form Submission
        document.getElementById('franchiseForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            console.log('Franchise application submitted:', data);

            // Hide form, show success message
            this.style.display = 'none';
            document.getElementById('franchiseSuccess').style.display = 'block';

            // Here you would normally send data to backend
            // For now, just log it and show success
        });
    </script>
    <!-- UAT Bug Reporter -->
    <script src="/frontend/bug-reporter.js"></script>
</body>
</html>
