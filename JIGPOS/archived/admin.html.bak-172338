<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>Admin Dashboard - Basotho Medical Herbs</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Arial', sans-serif; background: #1a1a1a; color: #fff; }
        
        .admin-nav {
            background: #000000;
            padding: 15px 0;
            border-bottom: 2px solid #FFFFFF;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .nav-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
        }
        
        .nav-logo {
            font-size: 1.8rem;
            font-weight: bold;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .nav-logo img.brand-logo {
            width: 150px !important;
            height: auto !important;
            border-radius: 0 !important;
            border: none !important;
        }
        
        .admin-badge {
            background: #FFFFFF;
            color: #000;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }
        
        .logout-btn {
            background: #FFFFFF;
            color: #000;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .logout-btn:hover {
            background: #e5e5e5;
            transform: translateY(-2px);
        }
        /* Compact Header Mode for POS */
        .admin-nav.compact-mode {
            padding: 8px 0 !important;
            transition: padding 0.3s;
        }
        
        .admin-nav.compact-mode .brand-logo {
            width: 80px !important;
            transition: width 0.3s;
        }
        
        .admin-nav.compact-mode .admin-badge {
            font-size: 0.75rem !important;
            padding: 3px 10px !important;
        }
        
        .admin-nav.compact-mode #adminEmail {
            display: none !important;
        }
        
        .admin-nav.compact-mode .logout-btn {
            padding: 6px 12px !important;
            font-size: 0.85rem !important;
        }

        /* Hamburger Menu Button */
        .hamburger-btn {
            background: none;
            border: none;
            color: #FFFFFF;
            font-size: 1.8rem;
            cursor: pointer;
            padding: 5px 10px;
            display: flex;
            align-items: center;
            transition: all 0.3s;
        }

        .hamburger-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 5px;
        }

        /* Left Sidebar Drawer */
        .sidebar-drawer {
            position: fixed;
            top: 0;
            left: -280px;
            width: 280px;
            height: 100vh;
            background: #0a0a0a;
            border-right: 2px solid #FFFFFF;
            z-index: 2500;
            transition: left 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            display: flex;
            flex-direction: column;
            box-shadow: 10px 0 50px rgba(0, 0, 0, 0.8);
        }

        .sidebar-drawer.active {
            left: 0;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .sidebar-header h2 {
            font-size: 1.3rem;
            color: #FFFFFF;
        }

        .sidebar-close {
            background: none;
            border: none;
            color: #FFFFFF;
            font-size: 2rem;
            cursor: pointer;
            padding: 0;
            line-height: 1;
            transition: all 0.2s;
        }

        .sidebar-close:hover {
            color: #e5e5e5;
            transform: rotate(90deg);
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            padding: 10px 0;
        }

        .sidebar-menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 20px;
            color: #FFFFFF;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s;
            border-left: 3px solid transparent;
        }

        .sidebar-menu-item:hover {
            background: rgba(255, 255, 255, 0.1);
            border-left-color: #FFFFFF;
        }

        .sidebar-menu-item.active {
            background: rgba(255, 255, 255, 0.15);
            border-left-color: #FFFFFF;
            font-weight: bold;
        }

        .sidebar-menu-item i {
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }

        /* Sidebar Overlay */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 2000;
            display: none;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .sidebar-overlay.active {
            display: block;
            opacity: 1;
        }

        .container {
            max-width: 1400px;
            margin: 40px auto;
            padding: 0 20px;
        }
        
        .alert-bar {
            background: #1a1a1a;
            border: 2px solid #FFFFFF;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
            color: #FFFFFF;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        @keyframes slideInRight {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes slideOutRight {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(400px);
                opacity: 0;
            }
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        
        .stat-card {
            background: #222;
            border-radius: 15px;
            padding: 25px;
            border: 1px solid #333;
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #FFFFFF;
        }
        
        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: #FFFFFF;
        }
        
        .stat-label {
            color: #999;
            margin-top: 10px;
        }
        
        .section {
            background: #222;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
        }
        
        .section-title {
            color: #FFFFFF;
            font-size: 1.5rem;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .tab-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 2px solid #333;
        }

        /* Hide main tabs until RBAC is applied to prevent flash */
        .tab-nav.main-tabs {
            visibility: hidden;
        }
        .tab-nav.main-tabs.rbac-ready {
            visibility: visible;
        }
        
        .tab {
            padding: 10px 20px;
            background: none;
            border: none;
            color: #999;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }
        
        .tab.active {
            color: #FFFFFF;
            border-bottom-color: #FFFFFF;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        
        th {
            background: #333;
            padding: 15px;
            text-align: left;
            color: #FFFFFF;
            border-bottom: 2px solid #FFFFFF;
        }
        
        td {
            padding: 15px;
            border-bottom: 1px solid #333;
        }
        
        tr:hover {
            background: rgba(220, 38, 38, 0.05);
        }
        
        .status-badge {
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 0.9rem;
            font-weight: bold;
        }
        
        .status-pending { background: #f59e0b; color: #000; }
        .status-approved { background: #4a4a4a; color: #fff; }
        .status-rejected { background: #1a1a1a; color: #fff; }
        .status-processing { background: #3b82f6; color: #fff; }
        .status-active { background: #2a2a2a; color: #fff; }
        .status-redeemed { background: #6b7280; color: #fff; }
        .status-paid { background: #4a4a4a; color: #fff; }
        .status-completed { background: #4a4a4a; color: #fff; }
        
        .action-btn {
            padding: 8px 15px;
            border: 1px solid #FFFFFF;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            margin-right: 5px;
            transition: all 0.3s;
            background: #000000;
            color: #FFFFFF;
        }

        .approve-btn {
            background: #FFFFFF;
            color: #000000;
            border: 1px solid #FFFFFF;
        }

        .approve-btn:hover {
            background: #000000;
            color: #FFFFFF;
        }

        .reject-btn {
            background: #2a2a2a;
            color: #FFFFFF;
            border: 1px solid #FFFFFF;
        }

        .reject-btn:hover {
            background: #FFFFFF;
            color: #000000;
        }

        .view-btn {
            background: #000000;
            color: #FFFFFF;
            border: 1px solid #FFFFFF;
        }

        .view-btn:hover {
            background: #FFFFFF;
            color: #000000;
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        
        .modal-content {
            background: #222;
            border-radius: 15px;
            padding: 30px;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            border: 2px solid #FFFFFF;
        }
        
        .close-modal {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            color: #fff;
            font-size: 1.5rem;
            cursor: pointer;
        }
        
        .filter-bar {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        
        .filter-bar input {
            flex: 1;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #333;
            background: #181818;
            color: #fff;
        }
        
        .filter-bar select {
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #333;
            background: #181818;
            color: #fff;
        }
        
        .proof-img {
            max-width: 100%;
            border-radius: 10px;
            margin-top: 10px;
            border: 2px solid #333;
        }
        
        .voucher-code {
            font-family: 'Courier New', monospace;
            background: #000;
            padding: 10px;
            border-radius: 5px;
            color: #FFFFFF;
            font-weight: bold;
            letter-spacing: 2px;
        }
        
        /* Mobile Responsiveness for Admin Panel */
        @media (max-width: 1024px) {
            .container {
                padding: 0 1rem;
            }
            
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
            }
            
            .tab-nav {
                flex-wrap: wrap;
                gap: 0.5rem;
            }
            
            .tab {
                font-size: 0.875rem;
                padding: 8px 16px;
            }
        }
        
        @media (max-width: 768px) {
            .admin-nav {
                padding: 1rem 0;
            }
            
            .nav-content {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
            
            .nav-logo {
                font-size: 1.2rem;
            }
            
            .nav-logo img {
                width: 40px !important;
                height: 40px !important;
            }
            
            .admin-badge {
                font-size: 0.8rem;
                padding: 4px 8px;
            }
            
            .container {
                padding: 0 0.75rem;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .stat-card {
                padding: 1rem;
            }
            
            .stat-value {
                font-size: 2rem;
            }
            
            .section {
                margin-bottom: 2rem;
            }
            
            .section-title {
                font-size: 1.3rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }
            
            .tab-nav {
                flex-direction: column;
                width: 100%;
            }
            
            .tab {
                width: 100%;
                text-align: center;
                padding: 12px;
            }
            
            table {
                font-size: 0.875rem;
            }
            
            table th, 
            table td {
                padding: 0.5rem;
            }
            
            .action-btn {
                padding: 6px 12px;
                font-size: 0.8rem;
                margin: 2px;
            }
            
            .filter-bar {
                flex-direction: column;
                gap: 1rem;
            }
            
            .filter-bar input,
            .filter-bar select {
                width: 100%;
                margin: 0;
            }
            
            .modal-content {
                width: 95%;
                margin: 1rem;
                max-height: 90vh;
                overflow-y: auto;
            }
            
            .alert-bar {
                padding: 0.75rem;
                font-size: 0.9rem;
            }
        }
        
        @media (max-width: 480px) {
            .nav-logo {
                font-size: 1rem;
                flex-direction: column;
                gap: 0.5rem;
            }
            
            .nav-logo img {
                width: 35px !important;
                height: 35px !important;
            }
            
            .admin-badge {
                font-size: 0.7rem;
            }
            
            .container {
                padding: 0 0.5rem;
            }
            
            .stat-card {
                padding: 0.75rem;
            }
            
            .stat-value {
                font-size: 1.5rem;
            }
            
            .stat-label {
                font-size: 0.8rem;
            }
            
            .section-title {
                font-size: 1.1rem;
            }
            
            .tab {
                font-size: 0.8rem;
                padding: 10px;
            }
            
            table {
                font-size: 0.8rem;
            }
            
            table th,
            table td {
                padding: 0.25rem;
            }
            
            .action-btn {
                padding: 4px 8px;
                font-size: 0.7rem;
            }
            
            .modal-content {
                padding: 1rem;
            }
            
            .modal-content h2 {
                font-size: 1.2rem;
            }
            
            .logout-btn {
                padding: 6px 12px;
                font-size: 0.85rem;
            }
        }
        
        /* Landscape mobile adjustments */
        @media (max-width: 768px) and (orientation: landscape) {
            .nav-content {
                flex-direction: row;
                justify-content: space-between;
            }
            
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .tab-nav {
                flex-direction: row;
                flex-wrap: wrap;
            }
        }
        
        /* Ensure touch targets are adequate */
        @media (pointer: coarse) {
            .tab, .action-btn, .logout-btn {
                min-height: 44px;
                min-width: 44px;
            }
            
            table th,
            table td {
                min-height: 44px;
            }
        }
        
        /* Handle very wide tables on mobile */
        @media (max-width: 768px) {
            .table-container {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            
            table {
                min-width: 600px;
            }
            
            /* Hide less important columns on small screens */
            .hide-mobile {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- Left Sidebar Drawer -->
    <div class="sidebar-drawer" id="sidebarDrawer">
        <div class="sidebar-header">
            <h2>Admin Menu</h2>
            <button class="sidebar-close" onclick="toggleSidebar()">&times;</button>
        </div>
        <div class="sidebar-menu">
            <div class="sidebar-menu-item active" onclick="navigateToTab('inventory')" data-tab="inventory">
                <i class="fas fa-box"></i>
                <span>Inventory</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('pos')" data-tab="pos">
                <i class="fas fa-cash-register"></i>
                <span>Point of Sale</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('payments')" data-tab="payments">
                <i class="fas fa-credit-card"></i>
                <span>Payments</span>
            </div>
            <div class="sidebar-menu-item" onclick="window.location.href='modules.html'" data-module="marketplace">
                <i class="fas fa-puzzle-piece"></i>
                <span>Module Marketplace</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('affiliates')" data-tab="affiliates" data-module="affiliate-system" style="display:none;">
                <i class="fas fa-users"></i>
                <span>Affiliates</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('vouchers')" data-tab="vouchers" data-module="voucher-system" style="display:none;">
                <i class="fas fa-ticket-alt"></i>
                <span>Vouchers</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('viral')" data-tab="viral" data-module="viral-engine" style="display:none;">
                <i class="fas fa-fire"></i>
                <span>Viral Marketing</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('orders')" data-tab="orders">
                <i class="fas fa-shopping-cart"></i>
                <span>Orders</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('users')" data-tab="users">
                <i class="fas fa-user-friends"></i>
                <span>Users</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('staff')" data-tab="staff">
                <i class="fas fa-id-badge"></i>
                <span>Staff</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('leads')" data-tab="leads">
                <i class="fas fa-bullhorn"></i>
                <span>Leads</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('marketing')" data-tab="marketing">
                <i class="fas fa-bullseye"></i>
                <span>Marketing</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('batches')" data-tab="batches">
                <i class="fas fa-layer-group"></i>
                <span>Batch Tracking</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('suppliers')" data-tab="suppliers">
                <i class="fas fa-truck"></i>
                <span>Suppliers</span>
            </div>
            <div class="sidebar-menu-item" onclick="navigateToTab('purchase-orders')" data-tab="purchase-orders">
                <i class="fas fa-file-invoice"></i>
                <span>Purchase Orders</span>
            </div>
            <hr style="border-color: rgba(255,255,255,0.2); margin: 10px 20px;">
            <div class="sidebar-menu-item" onclick="window.location.href='ormonde.html'" data-location="ormonde">
                <i class="fas fa-store-alt"></i>
                <span>Ormonde Dispensary</span>
            </div>
        </div>
    </div>

    <nav class="admin-nav">
        <div class="nav-content">
            <div class="nav-logo">
                <button class="hamburger-btn" onclick="toggleSidebar()" title="Menu">
                    <i class="fas fa-bars"></i>
                </button>
                <img src="/images/logo-w.png" alt="Basotho Medical Herbs" class="brand-logo" onerror="this.style.display='none'">
                <span class="admin-badge">ADMIN PANEL</span>
            </div>
            <div>
                <span id="adminEmail" style="margin-right: 20px; color: #999;">admin@basothomedicalherbs.ls</span>
                <button class="logout-btn" onclick="logout()">Logout</button>
            </div>
        </div>
    </nav>
    
    <div class="container">
        <!-- Alert Bar -->
        <div class="alert-bar" id="alertBar" style="display: none;">
            <i class="fas fa-exclamation-triangle" style="font-size: 1.5rem; color: #f59e0b;"></i>
            <span id="alertText">You have 0 pending payment approvals</span>
        </div>
        
        <!-- KPI Toggle Button -->
        <div style="margin-bottom: 16px;">
            <button id="adminKpiToggle" onclick="toggleAdminKpi()" style="background: #333; border: 2px solid #555; color: #fff; padding: 10px 20px; border-radius: 10px; cursor: pointer; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
                <i class="fas fa-chart-pie" style="color: #D4AF37;"></i> Dashboard KPIs
                <i class="fas fa-chevron-down" id="adminKpiChevron" style="font-size: 0.7rem; transition: transform 0.3s;"></i>
            </button>
        </div>
        <!-- KPI Slide-in Panel -->
        <div id="adminKpiPanel" style="max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.4,0,0.2,1); margin-bottom: 0;">
            <div class="stats-grid" id="adminKpiGrid" style="margin-bottom: 24px;">
                <div class="stat-card">
                    <div class="stat-value" style="font-size: 1rem; color: #999;">Loading...</div>
                    <div class="stat-label"><i class="fas fa-spinner fa-spin"></i></div>
                </div>
            </div>
        </div>
        
        <!-- Main Navigation Tabs -->
        <div class="tab-nav main-tabs" id="mainTabNav" style="margin-bottom: 30px;">
            <button class="tab active" onclick="showMainTab('inventory')">Inventory</button>
            <button class="tab" onclick="showMainTab('pos')" style="background: #2a2a2a; font-weight: bold; border: 2px solid #FFFFFF; color: #FFFFFF;"><i class="fas fa-cash-register"></i> POS</button>
            <button class="tab" onclick="showMainTab('payments')">Payments</button>
            <button class="tab" onclick="showMainTab('orders')">Orders</button>
            <button class="tab" onclick="showMainTab('users')">Users</button>
            <button class="tab" onclick="showMainTab('staff')">Staff</button>
            <button class="tab" onclick="showMainTab('leads')">Leads</button>
        </div>

        <!-- Inventory Management Section -->
        <div class="section tab-content active" id="inventory-tab">
            <div class="section-title">
                <span>Product Inventory Management</span>
                <div style="display: flex; gap: 10px;">
                    <button class="action-btn" style="background: #666666;" onclick="downloadCSVTemplate()">📥 Download CSV Template</button>
                    <button class="action-btn" style="background: #666666;" onclick="document.getElementById('csvUploadInput').click()">📤 Bulk Upload CSV</button>
                    <button class="action-btn" style="background: #8B7355;" onclick="exportProducts()">📊 Export Products</button>
                    <button class="action-btn approve-btn" onclick="openAddProductModal()">➕ Add New Product</button>
                </div>
            </div>
            <input type="file" id="csvUploadInput" accept=".csv" style="display: none;" onchange="handleCSVUpload(event)">

            <div class="filter-bar">
                <input type="text" placeholder="Search products by name, category, or SKU..." id="inventorySearch" onkeyup="filterInventory()">
                <select id="inventoryStatusFilter" onchange="filterInventory()">
                    <option value="all">All Products</option>
                    <option value="inStock">In Stock</option>
                    <option value="lowStock">Low Stock</option>
                    <option value="outOfStock">Out of Stock</option>
                </select>
                <select id="categoryCategoryFilter" onchange="filterInventory()">
                    <option value="all">All Categories</option>
                    <option value="lifestyle-cbd">BMH Wellness</option>
                    <option value="flower">Flower (Medical)</option>
                    <option value="oils">Oils</option>
                    <option value="edibles">Edibles</option>
                    <option value="accessories">Accessories</option>
                    <option value="coffee">Coffee</option>
                    <option value="vaporizers">Vaporizers</option>
                </select>
            </div>

            <table id="inventoryTable">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody">
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 40px; color: #999;">
                            Loading inventory...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Point of Sale Section -->
        <div class="section tab-content" id="pos-tab" style="display: none;">
            <div class="section-title">
                <span><i class="fas fa-cash-register"></i> Point of Sale - In-Store Sales</span>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <button class="action-btn" style="background: #2a2a2a;" onclick="clearPOSCart()"><i class="fas fa-trash"></i> Clear Cart</button>
                    <button class="action-btn" style="background: #666666;" onclick="loadPOSProducts()"><i class="fas fa-sync-alt"></i> Refresh</button>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; min-height: 600px;">
                <!-- Left: Product Selection -->
                <div style="background: #1a1a1a; border-radius: 10px; padding: 20px;">
                    <div style="margin-bottom: 15px; display: flex; gap: 10px;">
                        <input type="text" id="posSearch" placeholder="Search products by name or type SKU..."
                               style="flex: 1; padding: 15px; font-size: 1.1rem; background: #2a2a2a; border: 2px solid #666666; border-radius: 8px; color: #fff;"
                               onkeyup="handlePOSSearch(event)">
                        <button onclick="openBarcodeScanner()" class="action-btn" style="background: #666666; padding: 15px 20px; white-space: nowrap;">
                            <i class="fas fa-camera"></i> Scan
                        </button>
                    </div>

                    <div style="display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap;">
                        <button class="tab active" onclick="filterPOSByCategory('all')" style="flex: 1; min-width: 100px;">All</button>
                        <button class="tab" onclick="filterPOSByCategory('flower')" style="flex: 1; min-width: 100px;">Flower</button>
                        <button class="tab" onclick="filterPOSByCategory('pre-rolls')" style="flex: 1; min-width: 100px;">Pre-Rolls</button>
                        <button class="tab" onclick="filterPOSByCategory('vapes')" style="flex: 1; min-width: 100px;">Vapes</button>
                        <button class="tab" onclick="filterPOSByCategory('oils')" style="flex: 1; min-width: 100px;">Oils</button>
                        <button class="tab" onclick="filterPOSByCategory('edibles')" style="flex: 1; min-width: 100px;">Edibles</button>
                        <button class="tab" onclick="filterPOSByCategory('accessories')" style="flex: 1; min-width: 100px;">Accessories</button>
                        <button class="tab" onclick="filterPOSByCategory('lifestyle')" style="flex: 1; min-width: 100px;">Lifestyle</button>
                        <button class="tab" onclick="filterPOSByCategory('bean')" style="flex: 1; min-width: 100px;">Morija Roastery</button>
                        <button class="tab" onclick="filterPOSByCategory('brewha')" style="flex: 1; min-width: 100px;">Thaba Café</button>
                    </div>

                    <div id="posProductGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px; max-height: 500px; overflow-y: auto;">
                        <div style="text-align: center; padding: 40px; grid-column: 1 / -1; color: #999;">
                            Loading products...
                        </div>
                    </div>
                </div>

                <!-- Right: Cart & Checkout -->
                <div style="background: #1a1a1a; border-radius: 10px; padding: 20px; display: flex; flex-direction: column;">
                    <h3 style="margin-top: 0; color: #FFFFFF; border-bottom: 2px solid #666666; padding-bottom: 10px;">Shopping Cart</h3>

                    <div id="posCartItems" style="flex: 1; overflow-y: auto; margin-bottom: 15px; min-height: 200px;">
                        <div style="text-align: center; padding: 40px; color: #666;">
                            Cart is empty<br>
                            <small>Click products to add</small>
                        </div>
                    </div>

                    <div style="border-top: 2px solid #666666; padding-top: 15px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 1.1rem;">
                            <span>Subtotal:</span>
                            <span id="posSubtotal">R0.00</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <span>Discount:</span>
                            <span id="posDiscount" style="color: #4caf50;">-R0.00</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 1.3rem; font-weight: bold; color: #FFFFFF;">
                            <span>Total:</span>
                            <span id="posTotal">R0.00</span>
                        </div>

                        <input type="text" id="posCustomerPhone" placeholder="Customer Phone (optional)"
                               style="width: 100%; padding: 12px; background: #2a2a2a; border: 1px solid #666666; border-radius: 6px; color: #fff; margin-bottom: 10px;">

                        <input type="text" id="posCouponCode" placeholder="Coupon Code (optional)"
                               style="width: 100%; padding: 12px; background: #2a2a2a; border: 1px solid #666666; border-radius: 6px; color: #fff; margin-bottom: 10px;"
                               onchange="applyPOSCoupon()">

                        <button class="action-btn approve-btn" onclick="processPOSCheckout()"
                                style="width: 100%; padding: 18px; font-size: 1.2rem; background: #2a2a2a; border: 2px solid #FFFFFF; color: #FFFFFF;">
                            <i class="fas fa-credit-card"></i> Process Payment
                        </button>

                        <button class="action-btn" onclick="showRefundModal()"
                                style="width: 100%; padding: 15px; margin-top: 10px; font-size: 1.1rem; background: #4a4a4a; border: 2px solid #FFFFFF; color: #FFFFFF;">
                            <i class="fas fa-undo"></i> Returns / Refunds
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Approvals Section -->
        <div class="section tab-content" id="payments-tab" style="display: none;">
            <div class="section-title">
                <span><i class="fas fa-credit-card"></i> Payment Management</span>
                <button class="action-btn view-btn" onclick="refreshPendingPayments()" style="background: #666666;">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>

            <!-- Sub-tabs for different payment types -->
            <div class="tab-nav" style="margin-bottom: 20px; background: #333; padding: 10px; border-radius: 8px;">
                <button class="tab active" onclick="showPaymentType('pos-eft')" style="font-size: 0.9rem;">
                    POS EFT Payments
                </button>
                <button class="tab" onclick="showPaymentType('membership')" style="font-size: 0.9rem;">
                    Membership Payments
                </button>
                <button class="tab" onclick="showPaymentType('csv-export')" style="font-size: 0.9rem;">
                    <i class="fas fa-file-csv"></i> Sales Export
                </button>
            </div>

            <!-- POS EFT Payments (From in-store sales) -->
            <div id="pos-eft-payments" class="payment-type-section">
                <div class="filter-bar">
                    <input type="text" placeholder="Search by sale number, customer..." id="posPaymentSearch" onkeyup="filterPOSPayments()">
                    <select id="posBranchFilter" onchange="filterPOSPayments()">
                        <option value="all">All Branches</option>
                    </select>
                </div>

                <table id="posPaymentsTable">
                    <thead>
                        <tr>
                            <th>Sale #</th>
                            <th>Date/Time</th>
                            <th>Branch</th>
                            <th>Assistant</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Proof</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="posPaymentsList">
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 40px; color: #999;">
                                Loading pending POS payments...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Membership Payments (Legacy) -->
            <div id="membership-payments" class="payment-type-section" style="display: none;">
                <div class="filter-bar">
                    <input type="text" placeholder="Search by order number, email or phone..." id="paymentSearch" onkeyup="filterPayments()">
                    <select id="paymentStatusFilter" onchange="filterPayments()">
                        <option value="all">All Status</option>
                        <option value="pending" selected>Pending Only</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>

                <table id="paymentsTable">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Date/Time</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Proof</th>
                            <th>Membership</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="paymentsList">
                        <!-- Payments will be loaded here -->
                    </tbody>
                </table>
            </div>

            <!-- CSV Export for Accounting -->
            <div id="csv-export" class="payment-type-section" style="display: none;">
                <div style="background: #2a2a2a; padding: 24px; border-radius: 8px; margin-bottom: 20px;">
                    <h3 style="margin: 0 0 16px 0; color: #FFFFFF;">
                        Export Sales to Accounting Software
                    </h3>
                    <p style="margin: 0 0 24px 0; color: #999; line-height: 1.6;">
                        Export completed sales transactions to CSV format for import into your accounting software (Xero, QuickBooks, Sage, etc.)
                    </p>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: #999; font-size: 0.9rem;">Start Date</label>
                            <input type="date" id="exportStartDate" style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #444; border-radius: 4px; color: #FFFFFF;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: #999; font-size: 0.9rem;">End Date</label>
                            <input type="date" id="exportEndDate" style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #444; border-radius: 4px; color: #FFFFFF;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: #999; font-size: 0.9rem;">Format</label>
                            <select id="exportFormat" style="width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #444; border-radius: 4px; color: #FFFFFF;">
                                <option value="generic">Generic (All Data)</option>
                                <option value="xero">Xero</option>
                                <option value="quickbooks">QuickBooks Online</option>
                                <option value="sage">Sage</option>
                            </select>
                        </div>
                    </div>

                    <button onclick="exportSalesToCSV()" class="action-btn" style="width: 100%; padding: 14px; background: #666666; color: #FFFFFF; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer;">
                        <i class="fas fa-download"></i> Download CSV Export
                    </button>
                </div>

                <div style="background: #2a2a2a; padding: 20px; border-radius: 8px;">
                    <h4 style="margin: 0 0 12px 0; color: #FFFFFF;">Export Format Guide</h4>
                    <div style="display: grid; gap: 12px; color: #999; font-size: 0.9rem;">
                        <div>
                            <strong style="color: #FFFFFF;">Generic:</strong> Complete sales data with all fields - use for any accounting software
                        </div>
                        <div>
                            <strong style="color: #FFFFFF;">Xero:</strong> Formatted for direct import into Xero (InvoiceNumber, Date, Customer, Line Items, Tax)
                        </div>
                        <div>
                            <strong style="color: #FFFFFF;">QuickBooks:</strong> Optimized for QuickBooks Online import (Date, Transaction Type, Amount, Tax)
                        </div>
                        <div>
                            <strong style="color: #FFFFFF;">Sage:</strong> Sage-specific format (Type, Invoice Number, Net Amount, Tax Code, Gross Amount)
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Voucher Management Section -->
        <div class="section tab-content" id="vouchers-tab" style="display: none;">
            <div class="section-title">
                <span><i class="fas fa-ticket-alt"></i> Voucher Management</span>
                <button class="action-btn view-btn" onclick="showCreateVoucherModal()"><i class="fas fa-plus"></i> Create New Voucher</button>
            </div>

            <!-- Voucher Stats -->
            <div class="stats-grid" style="margin-bottom: 30px;">
                <div class="stat-card">
                    <div class="stat-value" id="totalVouchers">0</div>
                    <div class="stat-label">Total Vouchers</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="activeVouchers">0</div>
                    <div class="stat-label">Active</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="totalRedemptions">0</div>
                    <div class="stat-label">Total Redemptions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="totalDiscountGiven">R0</div>
                    <div class="stat-label">Total Discount Given</div>
                </div>
            </div>

            <div class="tab-nav">
                <button class="tab active" data-status="all" onclick="filterVouchers('all')">All Vouchers</button>
                <button class="tab" data-status="active" onclick="filterVouchers('active')">Active</button>
                <button class="tab" data-status="inactive" onclick="filterVouchers('inactive')">Inactive</button>
                <button class="tab" data-status="expired" onclick="filterVouchers('expired')">Expired</button>
            </div>

            <div class="table-container">
                <table id="vouchersTable">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Value</th>
                            <th>Redeemed</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="vouchersList">
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 40px;">
                                <i class="fas fa-spinner fa-spin" style="font-size: 24px; color: #ccc;"></i>
                                <p style="color: #999; margin-top: 10px;">Loading vouchers...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Create Voucher Modal -->
        <div id="createVoucherModal" class="modal" style="display: none;">
            <div class="modal-content" style="max-width: 600px;">
                <div class="modal-header">
                    <h3><i class="fas fa-ticket-alt"></i> Create New Voucher</h3>
                    <button class="modal-close" onclick="closeCreateVoucherModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <form id="createVoucherForm" onsubmit="createVoucher(event)">
                        <div class="form-group">
                            <label for="voucherCode">Voucher Code (leave blank to auto-generate)</label>
                            <input type="text" id="voucherCode" maxlength="20" placeholder="e.g., SUMMER2024" style="text-transform: uppercase;">
                            <button type="button" class="action-btn" onclick="generateVoucherCode()" style="margin-top: 5px; font-size: 12px; padding: 5px 10px;">
                                <i class="fas fa-random"></i> Generate Random Code
                            </button>
                        </div>

                        <div class="form-group">
                            <label for="voucherName">Name <span style="color: red;">*</span></label>
                            <input type="text" id="voucherName" required placeholder="e.g., Summer Sale 20% Off">
                        </div>

                        <div class="form-group">
                            <label for="voucherDescription">Description</label>
                            <textarea id="voucherDescription" rows="2" placeholder="Optional description for internal use"></textarea>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="voucherType">Type <span style="color: red;">*</span></label>
                                <select id="voucherType" required onchange="updateVoucherValueLabel()">
                                    <option value="percentage">Percentage Discount</option>
                                    <option value="fixed">Fixed Amount</option>
                                    <option value="free_shipping">Free Shipping</option>
                                    <option value="bogo">BOGO (Buy One Get One)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="voucherValue"><span id="voucherValueLabel">Percentage</span> <span style="color: red;">*</span></label>
                                <input type="number" id="voucherValue" required min="0" step="0.01" placeholder="e.g., 20">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="minPurchase">Minimum Purchase (R)</label>
                                <input type="number" id="minPurchase" min="0" step="0.01" value="0" placeholder="0">
                            </div>

                            <div class="form-group">
                                <label for="maxDiscount">Max Discount (R)</label>
                                <input type="number" id="maxDiscount" min="0" step="0.01" placeholder="Optional cap">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="startDate">Start Date</label>
                                <input type="datetime-local" id="startDate">
                            </div>

                            <div class="form-group">
                                <label for="expiryDate">Expiry Date <span style="color: red;">*</span></label>
                                <input type="datetime-local" id="expiryDate" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="redemptionLimit">Redemption Limit</label>
                                <select id="redemptionLimit">
                                    <option value="unlimited">Unlimited</option>
                                    <option value="once_per_customer">Once per Customer</option>
                                    <option value="single_use">Single Use Only</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="maxRedemptions">Max Total Redemptions</label>
                                <input type="number" id="maxRedemptions" min="1" placeholder="Leave blank for unlimited">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="internalNotes">Internal Notes</label>
                            <textarea id="internalNotes" rows="2" placeholder="Notes for admin use only"></textarea>
                        </div>

                        <div class="modal-actions">
                            <button type="button" class="cancel-btn" onclick="closeCreateVoucherModal()">Cancel</button>
                            <button type="submit" class="action-btn"><i class="fas fa-check"></i> Create Voucher</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Voucher Analytics Modal -->
        <div id="voucherAnalyticsModal" class="modal" style="display: none;">
            <div class="modal-content" style="max-width: 700px;">
                <div class="modal-header">
                    <h3><i class="fas fa-chart-line"></i> Voucher Analytics</h3>
                    <button class="modal-close" onclick="closeVoucherAnalyticsModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="analyticsContent">
                        <i class="fas fa-spinner fa-spin"></i> Loading analytics...
                    </div>
                </div>
            </div>
        </div>

        <!-- Module Marketplace Section -->
        <div class="section tab-content" id="modules-tab" style="display: none;">
            <div class="section-title">
                <span><i class="fas fa-puzzle-piece"></i> Module Marketplace</span>
                <button class="action-btn view-btn" onclick="loadMarketplace()"><i class="fas fa-sync"></i> Refresh</button>
            </div>

            <div class="stats-grid" style="margin-bottom: 30px;">
                <div class="stat-card">
                    <div class="stat-value" id="totalModules">0</div>
                    <div class="stat-label">Available Modules</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="installedModules">0</div>
                    <div class="stat-label">Installed</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="comingSoonModules">0</div>
                    <div class="stat-label">Coming Soon</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="totalModulesCost">R0</div>
                    <div class="stat-label">Monthly Cost</div>
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <select id="moduleCategory" onchange="filterModules()" style="padding: 10px; background: #2a2a2a; color: white; border: 1px solid #444; border-radius: 5px; margin-right: 10px;">
                    <option value="all">All Categories</option>
                    <option value="marketing">Marketing</option>
                    <option value="operations">Operations</option>
                    <option value="compliance">Compliance</option>
                    <option value="analytics">Analytics</option>
                    <option value="engagement">Engagement</option>
                </select>
                <select id="moduleStatus" onchange="filterModules()" style="padding: 10px; background: #2a2a2a; color: white; border: 1px solid #444; border-radius: 5px;">
                    <option value="all">All Status</option>
                    <option value="available">Available</option>
                    <option value="beta">Beta</option>
                    <option value="coming-soon">Coming Soon</option>
                    <option value="installed">Installed</option>
                </select>
            </div>

            <div id="marketplaceGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 25px;">
                <!-- Modules will be loaded here -->
            </div>
        </div>

        <!-- Affiliate Management Section -->
        <div class="section tab-content" id="affiliates-tab" style="display: none;">
            <div class="section-title">
                <span><i class="fas fa-user-friends"></i> Affiliate Management</span>
                <button class="action-btn view-btn" onclick="loadAffiliates()">Refresh</button>
            </div>
            
            <!-- Affiliate Stats -->
            <div class="stats-grid" style="margin-bottom: 30px;">
                <div class="stat-card">
                    <div class="stat-value" id="totalAffiliates">0</div>
                    <div class="stat-label">Total Affiliates</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="activeAffiliates">0</div>
                    <div class="stat-label">Active Affiliates</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="pendingAffiliates">0</div>
                    <div class="stat-label">Pending Approval</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="totalCommissions">R0</div>
                    <div class="stat-label">Total Commissions</div>
                </div>
            </div>
            
            <div class="filter-bar">
                <input type="text" placeholder="Search affiliates..." id="affiliateSearch" onkeyup="filterAffiliates()">
                <select id="affiliateStatusFilter" onchange="filterAffiliates()">
                    <option value="all">All Status</option>
                    <option value="pending">Pending</option>
                    <option value="active">Active</option>
                    <option value="suspended">Suspended</option>
                </select>
                <select id="affiliateTypeFilter" onchange="filterAffiliates()">
                    <option value="all">All Types</option>
                    <option value="soldier">Soldiers</option>
                    <option value="influencer">Influencers</option>
                    <option value="rep">Sales Reps</option>
                    <option value="ambassador">Ambassadors</option>
                </select>
            </div>
            
            <table id="affiliatesTable">
                <thead>
                    <tr>
                        <th>Affiliate</th>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Total Sales</th>
                        <th>Commission</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="affiliatesList">
                    <!-- Affiliates will be loaded here -->
                </tbody>
            </table>
        </div>
        
        <!-- Users Management Section -->
        <div class="section tab-content" id="users-tab" style="display: none;">
            <div class="section-title">
                <span>👤 User Management</span>
                <button class="action-btn view-btn" onclick="loadUsers()">Refresh</button>
            </div>
            
            <div class="filter-bar">
                <input type="text" placeholder="Search users..." id="userSearch" onkeyup="filterUsers()">
                <select id="userStatusFilter" onchange="filterUsers()">
                    <option value="all">All Users</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            
            <table id="usersTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Membership</th>
                        <th>Orders</th>
                        <th>Total Spent</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="usersList">
                    <!-- Users will be loaded here -->
                </tbody>
            </table>
        </div>

        <!-- Staff Management Section -->
        <div class="section tab-content" id="staff-tab" style="display: none;">
            <div class="section-title">
                <span>Staff Management</span>
                <button class="action-btn approve-btn" onclick="openAddStaffModal()">Add Staff Member</button>
            </div>

            <div class="filter-bar">
                <input type="text" placeholder="Search staff by name, email, or employee ID..." id="staffSearch" onkeyup="filterStaff()">
                <select id="staffRoleFilter" onchange="filterStaff()">
                    <option value="all">All Roles</option>
                    <option value="staff_manager">Store Manager</option>
                    <option value="staff_assistant">Shop Assistant</option>
                </select>
                <select id="staffStatusFilter" onchange="filterStaff()">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="all">All Status</option>
                </select>
            </div>

            <table id="staffTable">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Hire Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="staffList">
                    <!-- Staff will be loaded here -->
                </tbody>
            </table>
        </div>

        <!-- Orders Management -->
        <div class="section tab-content" id="orders-tab" style="display: none;">
            <div class="section-title">
                <span><i class="fas fa-box"></i> Order Management</span>
            </div>
            
            <table id="ordersTable">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Products</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="ordersList">
                    <!-- Orders will be loaded here -->
                </tbody>
            </table>
        </div>

        <!-- Lead Management Section -->
        <div class="section tab-content" id="leads-tab" style="display: none;">
            <div class="section-title">
                <span>Lead Management</span>
                <div class="stat-badges" style="display: flex; gap: 15px; flex-wrap: wrap;">
                    <span class="status-badge" style="background: #ff4444; color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem;">
                        <span id="newLeadsCount">0</span> New
                    </span>
                    <span class="status-badge" style="background: #4CAF50; color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem;">
                        <span id="convertedLeadsCount">0</span> Converted
                    </span>
                    <span class="status-badge" style="background: #2196F3; color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem;">
                        <span id="totalLeadsCount">0</span> Total
                    </span>
                </div>
            </div>

            <div class="filter-bar">
                <input type="text" placeholder="Search leads by name, email, or mobile..." id="leadSearch" onkeyup="filterLeads()">
                <select id="leadStatusFilter" onchange="filterLeads()">
                    <option value="all">All Statuses</option>
                    <option value="new">New</option>
                    <option value="contacted">Contacted</option>
                    <option value="qualified">Qualified</option>
                    <option value="converted">Converted</option>
                    <option value="rejected">Rejected</option>
                </select>
                <select id="leadTypeFilter" onchange="filterLeads()">
                    <option value="all">All Types</option>
                    <option value="waiting-list">Waiting List</option>
                    <option value="franchise-application">Franchise Application</option>
                    <option value="contact-form">Contact Form</option>
                </select>
                <select id="leadAssignedFilter" onchange="filterLeads()">
                    <option value="all">All Staff</option>
                    <option value="unassigned">Unassigned</option>
                    <!-- Staff options will be loaded dynamically -->
                </select>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="leadsList">
                    <!-- Leads will be loaded here -->
                </tbody>
            </table>
        </div>

        <!-- Loyalty Points Management Section -->
        <div class="section tab-content" id="loyalty-points-tab" style="display: none;">
            <div class="section-title">
                <span>Wellness Points Management</span>
                <div class="stat-badges" style="display: flex; gap: 15px; flex-wrap: wrap;">
                    <span class="status-badge" style="background: #4CAF50; color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem;">
                        <span id="totalPointsIssued">0</span> Points Issued
                    </span>
                    <span class="status-badge" style="background: #2196F3; color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem;">
                        <span id="totalPointsRedeemed">0</span> Points Redeemed
                    </span>
                    <span class="status-badge" style="background: #ff9800; color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem;">
                        <span id="activePointsBalance">0</span> Active Balance
                    </span>
                </div>
            </div>

            <!-- User Search & Manual Adjustment Card -->
            <div style="background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 20px; margin-bottom: 20px;">
                <h3 style="color: #FFFFFF; margin-bottom: 15px; font-size: 1.1rem;">Manual Points Adjustment</h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                    <div>
                        <label style="display: block; color: #999; font-size: 0.9rem; margin-bottom: 5px;">Search User</label>
                        <input type="text" id="pointsUserSearch" placeholder="Search by email or name..."
                               style="width: 100%; padding: 10px; background: #333; border: 1px solid #444; color: #fff; border-radius: 5px;">
                        <div id="userSearchResults" style="background: #2a2a2a; border: 1px solid #444; border-radius: 5px; margin-top: 5px; max-height: 200px; overflow-y: auto; display: none;">
                            <!-- Search results will appear here -->
                        </div>
                    </div>

                    <div>
                        <label style="display: block; color: #999; font-size: 0.9rem; margin-bottom: 5px;">Selected User</label>
                        <div id="selectedUserInfo" style="padding: 10px; background: #333; border: 1px solid #444; border-radius: 5px; color: #999; min-height: 42px;">
                            No user selected
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 15px; margin-bottom: 15px;">
                    <div>
                        <label style="display: block; color: #999; font-size: 0.9rem; margin-bottom: 5px;">Points Amount</label>
                        <input type="number" id="pointsAmount" placeholder="100"
                               style="width: 100%; padding: 10px; background: #333; border: 1px solid #444; color: #fff; border-radius: 5px;">
                    </div>

                    <div>
                        <label style="display: block; color: #999; font-size: 0.9rem; margin-bottom: 5px;">Action Type</label>
                        <select id="pointsActionType"
                                style="width: 100%; padding: 10px; background: #333; border: 1px solid #444; color: #fff; border-radius: 5px;">
                            <option value="add">Add Points</option>
                            <option value="subtract">Subtract Points</option>
                            <option value="set">Set Balance</option>
                        </select>
                    </div>

                    <div>
                        <label style="display: block; color: #999; font-size: 0.9rem; margin-bottom: 5px;">Reason</label>
                        <input type="text" id="pointsReason" placeholder="E.g. Compensation, Birthday bonus, etc."
                               style="width: 100%; padding: 10px; background: #333; border: 1px solid #444; color: #fff; border-radius: 5px;">
                    </div>
                </div>

                <button class="action-btn" onclick="adjustUserPoints()" id="adjustPointsBtn" disabled
                        style="background: #4CAF50; width: 100%; padding: 12px;">
                    Apply Points Adjustment
                </button>
            </div>

            <!-- Tier Override Card -->
            <div style="background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 20px; margin-bottom: 20px;">
                <h3 style="color: #FFFFFF; margin-bottom: 15px; font-size: 1.1rem;">Tier Override</h3>

                <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 15px;">
                    <div>
                        <div id="tierOverrideUserInfo" style="padding: 10px; background: #333; border: 1px solid #444; border-radius: 5px; color: #999; min-height: 42px;">
                            Select a user from search above
                        </div>
                    </div>

                    <div>
                        <select id="tierOverrideSelect"
                                style="width: 100%; padding: 10px; background: #333; border: 1px solid #444; color: #fff; border-radius: 5px;" disabled>
                            <option value="seedling">Seedling (R0+)</option>
                            <option value="vegetative">Vegetative (R1,000+)</option>
                            <option value="flowering">Flowering (R5,000+)</option>
                            <option value="harvest">Harvest (R15,000+)</option>
                        </select>
                    </div>

                    <div>
                        <button class="action-btn" onclick="overrideUserTier()" id="overrideTierBtn" disabled
                                style="background: #ff9800; width: 100%; padding: 12px;">
                            Override Tier
                        </button>
                    </div>
                </div>
            </div>

            <!-- Points Transactions Table -->
            <div class="filter-bar">
                <input type="text" placeholder="Search transactions by user email or reason..." id="transactionSearch" onkeyup="filterPointsTransactions()">
                <select id="transactionTypeFilter" onchange="filterPointsTransactions()">
                    <option value="all">All Types</option>
                    <option value="earned">Earned</option>
                    <option value="redeemed">Redeemed</option>
                    <option value="adjusted">Admin Adjusted</option>
                    <option value="expired">Expired</option>
                </select>
                <select id="transactionDateFilter" onchange="filterPointsTransactions()">
                    <option value="all">All Time</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                </select>
                <button class="action-btn" onclick="loadPointsTransactions()" style="background: #2196F3;">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Reason</th>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Expires</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="pointsTransactionsList">
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 40px; color: #666;">
                            <i class="fas fa-award" style="font-size: 3rem; margin-bottom: 10px; opacity: 0.3;"></i>
                            <p>No points transactions yet</p>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Bulk Actions -->
            <div style="background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 20px; margin-top: 20px;">
                <h3 style="color: #FFFFFF; margin-bottom: 15px; font-size: 1.1rem;">Bulk Actions</h3>

                <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                    <button class="action-btn" onclick="exportPointsData()" style="background: #2196F3;">
                        <i class="fas fa-download"></i> Export Points Data (CSV)
                    </button>
                    <button class="action-btn" onclick="expireOldPoints()" style="background: #ff9800;">
                        <i class="fas fa-clock"></i> Process Expired Points
                    </button>
                    <button class="action-btn" onclick="generatePointsReport()" style="background: #9C27B0;">
                        <i class="fas fa-chart-bar"></i> Generate Points Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Viral Module Section -->
        <div class="section tab-content" id="viral-tab" style="display: none;">
            <div class="section-title">
                <span>Viral Marketing & Influencer Management</span>
                <button class="action-btn approve-btn" onclick="createViralCampaign()">
                    <i class="fas fa-rocket"></i> Create Campaign
                </button>
            </div>

            <!-- Stats Overview -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px; margin-bottom: 25px;">
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 8px;">
                    <div style="color: rgba(255,255,255,0.9); font-size: 0.875rem; margin-bottom: 5px;">Active Influencers</div>
                    <div style="color: #FFFFFF; font-size: 2rem; font-weight: 700;" id="viralActiveInfluencers">0</div>
                </div>
                <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 20px; border-radius: 8px;">
                    <div style="color: rgba(255,255,255,0.9); font-size: 0.875rem; margin-bottom: 5px;">Total Viral Score</div>
                    <div style="color: #FFFFFF; font-size: 2rem; font-weight: 700;" id="viralTotalScore">0</div>
                </div>
                <div style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); padding: 20px; border-radius: 8px;">
                    <div style="color: rgba(255,255,255,0.9); font-size: 0.875rem; margin-bottom: 5px;">Active Campaigns</div>
                    <div style="color: #FFFFFF; font-size: 2rem; font-weight: 700;" id="viralActiveCampaigns">0</div>
                </div>
                <div style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); padding: 20px; border-radius: 8px;">
                    <div style="color: rgba(255,255,255,0.9); font-size: 0.875rem; margin-bottom: 5px;">Viral Reach</div>
                    <div style="color: #FFFFFF; font-size: 2rem; font-weight: 700;" id="viralTotalReach">0</div>
                </div>
            </div>

            <!-- Tab Navigation -->
            <div class="tab-nav" style="margin-bottom: 20px;">
                <button class="tab active" onclick="showViralSection('campaigns')">Campaigns</button>
                <button class="tab" onclick="showViralSection('influencers')">Influencers</button>
                <button class="tab" onclick="showViralSection('products')">Product Scores</button>
                <button class="tab" onclick="showViralSection('analytics')">Analytics</button>
            </div>

            <!-- Campaigns Section -->
            <div id="viral-campaigns-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="color: #FFFFFF; font-size: 1.2rem; margin: 0;">Marketing Campaigns</h3>
                    <input type="text" placeholder="Search campaigns..." id="campaignSearch" onkeyup="filterCampaigns()"
                           style="width: 300px; padding: 8px 12px; background: #1a1a1a; border: 1px solid #333; color: #FFFFFF; border-radius: 5px;">
                </div>

                <div class="table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Campaign Name</th>
                                <th>Status</th>
                                <th>Products</th>
                                <th>Influencers</th>
                                <th>Total Reach</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="campaignsTableBody">
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 40px; color: #999;">
                                    Loading campaigns...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Influencers Section -->
            <div id="viral-influencers-section" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="color: #FFFFFF; font-size: 1.2rem; margin: 0;">Influencer Network</h3>
                    <div style="display: flex; gap: 10px;">
                        <select id="influencerTierFilter" onchange="filterInfluencers()"
                                style="padding: 8px 12px; background: #1a1a1a; border: 1px solid #333; color: #FFFFFF; border-radius: 5px;">
                            <option value="all">All Tiers</option>
                            <option value="mega">Mega (1M+)</option>
                            <option value="macro">Macro (500K-1M)</option>
                            <option value="mid">Mid (100K-500K)</option>
                            <option value="micro">Micro (10K-100K)</option>
                            <option value="nano">Nano (1K-10K)</option>
                        </select>
                        <input type="text" placeholder="Search influencers..." id="influencerSearch" onkeyup="filterInfluencers()"
                               style="width: 300px; padding: 8px 12px; background: #1a1a1a; border: 1px solid #333; color: #FFFFFF; border-radius: 5px;">
                    </div>
                </div>

                <div class="table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Tier</th>
                                <th>Followers</th>
                                <th>Platform</th>
                                <th>Commission Rate</th>
                                <th>Total Sales</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="influencersTableBody">
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 40px; color: #999;">
                                    Loading influencers...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Product Scores Section -->
            <div id="viral-products-section" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="color: #FFFFFF; font-size: 1.2rem; margin: 0;">Viral Product Scores</h3>
                    <button class="action-btn" onclick="recalculateAllScores()" style="background: #667eea;">
                        <i class="fas fa-sync"></i> Recalculate Scores
                    </button>
                </div>

                <div class="table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Viral Score</th>
                                <th>Views</th>
                                <th>Shares</th>
                                <th>Purchases</th>
                                <th>Engagement Rate</th>
                                <th>Trending</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productScoresTableBody">
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 40px; color: #999;">
                                    Loading product scores...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Analytics Section -->
            <div id="viral-analytics-section" style="display: none;">
                <h3 style="color: #FFFFFF; font-size: 1.2rem; margin-bottom: 20px;">Viral Analytics & Insights</h3>

                <div style="background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 25px; margin-bottom: 20px;">
                    <h4 style="color: #FFFFFF; margin-bottom: 15px;">Performance Metrics</h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                        <div>
                            <div style="color: #999; font-size: 0.875rem; margin-bottom: 5px;">Total Impressions</div>
                            <div style="color: #FFFFFF; font-size: 1.5rem; font-weight: 700;" id="analyticsImpressions">0</div>
                        </div>
                        <div>
                            <div style="color: #999; font-size: 0.875rem; margin-bottom: 5px;">Click-Through Rate</div>
                            <div style="color: #FFFFFF; font-size: 1.5rem; font-weight: 700;" id="analyticsCTR">0%</div>
                        </div>
                        <div>
                            <div style="color: #999; font-size: 0.875rem; margin-bottom: 5px;">Conversion Rate</div>
                            <div style="color: #FFFFFF; font-size: 1.5rem; font-weight: 700;" id="analyticsConversion">0%</div>
                        </div>
                        <div>
                            <div style="color: #999; font-size: 0.875rem; margin-bottom: 5px;">Revenue from Viral</div>
                            <div style="color: #FFFFFF; font-size: 1.5rem; font-weight: 700;" id="analyticsRevenue">R0</div>
                        </div>
                    </div>
                </div>

                <div style="background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 25px;">
                    <h4 style="color: #FFFFFF; margin-bottom: 15px;">Top Performing Content</h4>
                    <div id="topContentList">
                        <p style="color: #999; text-align: center; padding: 20px;">No data available</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Approval Modal -->
    <div id="paymentModal" class="modal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeModal('paymentModal')">&times;</button>
            <h2 style="color: #FFFFFF; margin-bottom: 20px;">🔍 Payment Verification</h2>
            
            <div id="paymentDetails">
                <!-- Payment details will be loaded here -->
            </div>
            
            <div style="margin-top: 20px;">
                <textarea id="approvalNotes" placeholder="Add notes (optional)..." style="width: 100%; padding: 10px; background: #333; border: 1px solid #444; color: #fff; border-radius: 5px; margin-bottom: 15px;" rows="3"></textarea>
                
                <div style="display: flex; gap: 10px;" id="localStoragePOPButtons">
                    <button class="action-btn approve-btn" style="flex: 1; padding: 15px;" onclick="if(currentPaymentIndex !== null) { quickApprove(currentPaymentIndex); closeModal('paymentModal'); }">
                        APPROVE & ACTIVATE MEMBERSHIP
                    </button>
                    <button class="action-btn reject-btn" style="flex: 1; padding: 15px;" onclick="if(currentPaymentIndex !== null) { quickReject(currentPaymentIndex); closeModal('paymentModal'); }">
                        REJECT PAYMENT
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Voucher Detail Modal -->
    <div id="voucherModal" class="modal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeModal('voucherModal')">&times;</button>
            <h2 style="color: #FFFFFF; margin-bottom: 20px;"><i class="fas fa-ticket-alt"></i> Voucher Details</h2>
            
            <div id="voucherDetails">
                <!-- Voucher details will be loaded here -->
            </div>
            
            <div style="margin-top: 20px; display: flex; gap: 10px;">
                <button class="action-btn reject-btn" onclick="cancelVoucher()">Cancel Voucher</button>
                <button class="action-btn view-btn" onclick="resendVoucher()">Resend to Email</button>
            </div>
        </div>
    </div>

    <!-- Add/Edit Staff Modal -->
    <div id="staffModal" class="modal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeStaffModal()">&times;</button>
            <h2 style="color: #FFFFFF; margin-bottom: 20px;" id="staffModalTitle">Add Staff Member</h2>

            <form id="staffForm" onsubmit="saveStaff(event)">
                <input type="hidden" id="staffId">

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div>
                        <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">First Name *</label>
                        <input type="text" id="staffFirstName" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                    </div>

                    <div>
                        <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Last Name *</label>
                        <input type="text" id="staffLastName" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                    </div>
                </div>

                <div style="margin-top: 15px;">
                    <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Email *</label>
                    <input type="email" id="staffEmail" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                </div>

                <div style="margin-top: 15px;" id="passwordField">
                    <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Password * (min 8 characters)</label>
                    <input type="password" id="staffPassword" minlength="8" style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px;">
                    <div>
                        <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Phone</label>
                        <input type="tel" id="staffPhone" placeholder="+27 XX XXX XXXX" style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                    </div>

                    <div>
                        <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Role *</label>
                        <select id="staffRole" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                            <option value="">Select Role</option>
                            <option value="staff_manager">Store Manager</option>
                            <option value="staff_assistant">Shop Assistant</option>
                        </select>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px;">
                    <div>
                        <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Department</label>
                        <input type="text" id="staffDepartment" placeholder="e.g., Operations, Sales" style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                    </div>

                    <div>
                        <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Work Schedule</label>
                        <select id="staffWorkSchedule" style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                            <option value="full-time">Full-time</option>
                            <option value="part-time">Part-time</option>
                            <option value="contract">Contract</option>
                        </select>
                    </div>
                </div>

                <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" class="action-btn reject-btn" onclick="closeStaffModal()">Cancel</button>
                    <button type="submit" class="action-btn approve-btn">Save Staff Member</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Lead Detail Modal -->
    <div id="leadModal" class="modal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeLeadModal()">&times;</button>
            <h2 style="color: #FFFFFF; margin-bottom: 20px;">Lead Details</h2>

            <div id="leadDetails" style="margin-bottom: 20px;">
                <!-- Lead details will be loaded here -->
            </div>

            <form id="leadForm" onsubmit="updateLead(event)">
                <input type="hidden" id="leadId">

                <div style="margin-top: 15px;">
                    <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Status *</label>
                    <select id="leadStatus" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                        <option value="new">New</option>
                        <option value="contacted">Contacted</option>
                        <option value="qualified">Qualified</option>
                        <option value="converted">Converted</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>

                <div style="margin-top: 15px;">
                    <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Assign To</label>
                    <select id="leadAssignedTo" style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;">
                        <option value="">Unassigned</option>
                        <!-- Staff options will be loaded dynamically -->
                    </select>
                </div>

                <div style="margin-top: 15px;">
                    <label style="color: #FFFFFF; display: block; margin-bottom: 5px;">Notes</label>
                    <textarea id="leadNotes" rows="4" placeholder="Add notes about this lead..." style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #333; background: #1a1a1a; color: #FFFFFF;"></textarea>
                </div>

                <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: space-between;">
                    <div style="display: flex; gap: 10px;">
                        <a id="leadEmail" href="" class="action-btn view-btn" style="text-decoration: none; display: inline-block;">Email Lead</a>
                        <a id="leadPhone" href="" class="action-btn view-btn" style="text-decoration: none; display: inline-block;">Call Lead</a>
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <button type="button" class="action-btn reject-btn" onclick="closeLeadModal()">Cancel</button>
                        <button type="submit" class="action-btn approve-btn">Update Lead</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        // VERSION 2.0 - Force fresh function definitions (prevents caching issues)
        // Define showAdminToast FIRST to ensure it's never cached as alert()
        window.showAdminToast = function(title, message, type = 'info') {
            document.querySelectorAll('.admin-toast').forEach(t => t.remove());
            const toast = document.createElement('div');
            toast.className = 'admin-toast';
            let iconBg = '#333';
            let icon = 'fa-info-circle';
            let borderColor = '#444';
            if (type === 'success') {
                iconBg = '#ffffff';
                icon = 'fa-check';
                borderColor = '#ffffff';
            } else if (type === 'error') {
                iconBg = '#ff4444';
                icon = 'fa-times';
                borderColor = '#ff4444';
            } else if (type === 'warning') {
                iconBg = '#ffaa00';
                icon = 'fa-exclamation';
                borderColor = '#ffaa00';
            }
            toast.innerHTML = `
                <style>
                    @keyframes toastSlideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
                    @keyframes toastSlideOut { from { transform: translateX(0); opacity: 1; } to { transform: translateX(100%); opacity: 0; } }
                </style>
                <div style="display: flex; align-items: center; gap: 16px;">
                    <div style="width: 40px; height: 40px; background: ${iconBg}; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fas ${icon}" style="font-size: 18px; color: ${type === 'success' ? '#000' : '#fff'};"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-weight: 700; font-size: 1rem; margin-bottom: 2px; color: #FFFFFF;">${title}</div>
                        <div style="font-size: 0.85rem; color: #999; white-space: pre-line;">${message}</div>
                    </div>
                    <button onclick="this.closest('.admin-toast').remove()" style="background: none; border: none; color: #666; font-size: 1.25rem; cursor: pointer; padding: 4px; margin-left: 8px; flex-shrink: 0; line-height: 1;">&times;</button>
                </div>
            `;
            toast.style.cssText = `position: fixed; top: 20px; right: 20px; background: #000000; border: 2px solid ${borderColor}; padding: 16px 20px; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); z-index: 200000; min-width: 320px; max-width: 420px; animation: toastSlideIn 0.3s ease-out;`;
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.animation = 'toastSlideOut 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 4000);
        };
        console.log('[Admin v2.0] Fresh showAdminToast loaded');

        // Get user role from sessionStorage
        const user = JSON.parse(sessionStorage.getItem('user') || '{}');
        const userRole = user.role || 'user';

        console.log('[RBAC] User role:', userRole);

        // Redirect non-staff users
        const allowedRoles = ['admin', 'staff_manager', 'staff_assistant'];
        if (!allowedRoles.includes(userRole)) {
            console.log('[RBAC] Unauthorized role, redirecting to dashboard');
            window.location.href = 'dashboard.html';
        }

        // Role-based access control matrix
        const rolePermissions = {
            'admin': {
                tabs: ['inventory', 'pos', 'payments', 'orders', 'users', 'staff', 'leads'],
                name: 'Administrator'
            },
            'staff_manager': {
                tabs: ['inventory', 'pos', 'payments', 'orders', 'staff', 'leads'],
                name: 'Store Manager'
            },
            'staff_assistant': {
                tabs: ['pos'],
                name: 'Shop Assistant'
            }
        };

        // Apply RBAC - hide tabs based on user role
        function applyRBAC() {
            const permissions = rolePermissions[userRole];
            if (!permissions) {
                console.error('[RBAC] No permissions found for role:', userRole);
                return;
            }

            console.log('[RBAC] Applying permissions for', permissions.name, '- Allowed tabs:', permissions.tabs);

            // Get all tab buttons
            const allTabButtons = document.querySelectorAll('.tab-nav .tab');

            allTabButtons.forEach(tabButton => {
                const onclick = tabButton.getAttribute('onclick');

                // Extract tab name from onclick="showMainTab('inventory')"
                const match = onclick?.match(/showMainTab\('([^']+)'\)/);
                if (match) {
                    const tabName = match[1];

                    if (!permissions.tabs.includes(tabName)) {
                        // Hide tab that user doesn't have access to
                        tabButton.style.display = 'none';
                        console.log('[RBAC] Hiding tab:', tabName);
                    } else {
                        console.log('[RBAC] Showing tab:', tabName);
                    }
                }
            });

            // Also hide sidebar menu items that correspond to hidden tabs
            const sidebarItems = document.querySelectorAll('.sidebar-menu-item');
            sidebarItems.forEach(item => {
                const onclick = item.getAttribute('onclick');
                const match = onclick?.match(/showMainTab\('([^']+)'\)/);
                if (match) {
                    const tabName = match[1];
                    if (!permissions.tabs.includes(tabName)) {
                        item.style.display = 'none';
                        console.log('[RBAC] Hiding sidebar item:', tabName);
                    }
                }
            });

            // If assistant, auto-navigate to POS tab
            if (userRole === 'staff_assistant') {
                console.log('[RBAC] Assistant role detected - auto-opening POS tab');
                setTimeout(() => showMainTab('pos'), 500);
            }
        }

        // Global variables
        const API_URL = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
            ? 'http://localhost:3001/api/v1'
            : `${window.location.protocol}//${window.location.host}/api/v1`;

        let currentPaymentIndex = null;
        let currentVoucherIndex = null;

        // ── KPI Dashboard Loading ─────────────────────────────────────────────
        let adminKpiOpen = false;
        let adminKpiLoaded = false;

        function toggleAdminKpi() {
            const panel = document.getElementById('adminKpiPanel');
            const chevron = document.getElementById('adminKpiChevron');
            const btn = document.getElementById('adminKpiToggle');
            if (!panel) return;
            adminKpiOpen = !adminKpiOpen;
            panel.style.maxHeight = adminKpiOpen ? '300px' : '0';
            panel.style.marginBottom = adminKpiOpen ? '0' : '0';
            if (chevron) chevron.style.transform = adminKpiOpen ? 'rotate(180deg)' : 'rotate(0deg)';
            if (btn) btn.style.borderColor = adminKpiOpen ? '#D4AF37' : '#555';
            if (adminKpiOpen && !adminKpiLoaded) { loadKPIs(); adminKpiLoaded = true; }
        }

        async function loadKPIs() {
            const token = sessionStorage.getItem('adminToken');
            if (!token) return;
            try {
                const resp = await fetch(`${API_URL}/dashboard/kpis`, {
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
                });
                if (!resp.ok) throw new Error('KPI fetch failed');
                const data = await resp.json();
                renderKPICards(data.role, data.kpis);
            } catch (err) {
                console.error('[KPI] Error:', err);
                document.getElementById('adminKpiGrid').innerHTML = '';
            }
        }

        function renderKPICards(role, kpis) {
            const grid = document.getElementById('adminKpiGrid');
            if (!grid) return;
            let cards = '';

            if (role === 'super_admin') {
                cards = `
                    <div class="stat-card"><div class="stat-value">R${formatNumber(kpis.revenueToday)}</div><div class="stat-label"><i class="fas fa-dollar-sign" style="color:#D4AF37;"></i> Revenue Today</div></div>
                    <div class="stat-card"><div class="stat-value">R${formatNumber(kpis.revenueWeek)}</div><div class="stat-label"><i class="fas fa-chart-line" style="color:#4ade80;"></i> Revenue This Week</div></div>
                    <div class="stat-card"><div class="stat-value">R${formatNumber(kpis.revenueMonth)}</div><div class="stat-label"><i class="fas fa-chart-bar" style="color:#60a5fa;"></i> Revenue This Month</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.totalActiveUsers}</div><div class="stat-label"><i class="fas fa-users" style="color:#a78bfa;"></i> Active Users</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.newUsersThisWeek}</div><div class="stat-label"><i class="fas fa-user-plus" style="color:#4ade80;"></i> New Users This Week</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.transactionsToday}</div><div class="stat-label"><i class="fas fa-receipt" style="color:#f59e0b;"></i> Transactions Today</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.pendingApprovals.cashups}</div><div class="stat-label"><i class="fas fa-clock" style="color:#dc3545;"></i> Pending Cashups</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.pendingApprovals.purchaseOrders}</div><div class="stat-label"><i class="fas fa-file-invoice" style="color:#f59e0b;"></i> Pending POs</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.pendingApprovals.section21Docs}</div><div class="stat-label"><i class="fas fa-file-medical" style="color:#dc3545;"></i> Pending S21 Docs</div></div>`;
            } else if (role === 'admin') {
                cards = `
                    <div class="stat-card"><div class="stat-value">R${formatNumber(kpis.salesToday)}</div><div class="stat-label"><i class="fas fa-dollar-sign" style="color:#D4AF37;"></i> Sales Today</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.transactionsToday}</div><div class="stat-label"><i class="fas fa-receipt" style="color:#4ade80;"></i> Transactions Today</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.onlineOrdersToday}</div><div class="stat-label"><i class="fas fa-shopping-cart" style="color:#60a5fa;"></i> Online Orders Today</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.pendingOrders}</div><div class="stat-label"><i class="fas fa-clock" style="color:#f59e0b;"></i> Pending Orders</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.lowStockAlerts}</div><div class="stat-label"><i class="fas fa-exclamation-triangle" style="color:#dc3545;"></i> Low Stock Alerts</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.expiringStockAlerts}</div><div class="stat-label"><i class="fas fa-calendar-times" style="color:#f59e0b;"></i> Expiring Stock</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.pendingPurchaseOrders}</div><div class="stat-label"><i class="fas fa-file-invoice" style="color:#a78bfa;"></i> Pending POs</div></div>`;
            } else if (role === 'branch_manager') {
                cards = `
                    <div class="stat-card"><div class="stat-value">R${formatNumber(kpis.branchSalesToday)}</div><div class="stat-label"><i class="fas fa-dollar-sign" style="color:#D4AF37;"></i> Branch Sales Today</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.branchTransactionsToday}</div><div class="stat-label"><i class="fas fa-receipt" style="color:#4ade80;"></i> Transactions Today</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.tillsOpen}</div><div class="stat-label"><i class="fas fa-cash-register" style="color:#60a5fa;"></i> Tills Open</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.cashupsPending}</div><div class="stat-label"><i class="fas fa-clock" style="color:#f59e0b;"></i> Cashups Pending</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.lowStockAlerts}</div><div class="stat-label"><i class="fas fa-exclamation-triangle" style="color:#dc3545;"></i> Low Stock Alerts</div></div>
                    <div class="stat-card"><div class="stat-value">${kpis.staffOnShift}</div><div class="stat-label"><i class="fas fa-users" style="color:#a78bfa;"></i> Staff on Shift</div></div>`;
            }

            grid.innerHTML = cards;
        }

        function formatNumber(num) {
            if (num == null || isNaN(num)) return '0';
            return Number(num).toLocaleString('en-ZA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Load dashboard data
        function loadDashboard() {
            const userRole = sessionStorage.getItem('userRole') || 'user';
            loadPayments();
            // Only load vouchers for admin
            if (userRole === 'admin') {
                loadVouchers();
            }
            loadOrders();
            updateStats();
        }
        
        async function updateStats() {
            try {
                const token = sessionStorage.getItem('adminToken');
                if (!token) {
                    return;
                }

                // Fetch all orders
                const response = await fetch(`${API_URL}/orders/all`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch stats');
                }

                const data = await response.json();
                const orders = data.orders || [];

                // Calculate stats
                const pendingCount = orders.filter(o => o.paymentStatus === 'pending').length;

                // Today's stats
                const today = new Date().toDateString();
                const todayOrders = orders.filter(o => new Date(o.createdAt).toDateString() === today);
                const todayRevenue = todayOrders.reduce((sum, o) => sum + (o.total || 0), 0);

                // Update display
                document.getElementById('pendingPayments').textContent = pendingCount;
                document.getElementById('todayRevenue').textContent = `R ${todayRevenue.toFixed(2)}`;

                // Fetch new members count for today
                try {
                    const usersResponse = await fetch(`${API_URL}/users`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (usersResponse.ok) {
                        const usersData = await usersResponse.json();
                        const users = usersData.users || [];
                        const todayStart = new Date();
                        todayStart.setHours(0, 0, 0, 0);
                        const newMembersToday = users.filter(u => new Date(u.createdAt) >= todayStart).length;
                        document.getElementById('newMembers').textContent = newMembersToday;
                    } else {
                        document.getElementById('newMembers').textContent = '0';
                    }
                } catch (userError) {
                    console.warn('Could not fetch new members count:', userError);
                    document.getElementById('newMembers').textContent = '0';
                }

                // Show alert if pending payments
                if (pendingCount > 0) {
                    document.getElementById('alertBar').style.display = 'flex';
                    document.getElementById('alertText').textContent = `You have ${pendingCount} pending payment approval${pendingCount > 1 ? 's' : ''} requiring immediate attention!`;
                }
            } catch (error) {
                console.error('Update stats error:', error);
            }
        }
        
        async function loadPayments() {
            const tbody = document.getElementById('paymentsList');

            try {
                const token = sessionStorage.getItem('adminToken');
                if (!token) {
                    tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #999;">Please login to view payments</td></tr>';
                    return;
                }

                // Fetch orders with pending payment status (using global API_URL)
                const response = await fetch(`${API_URL}/orders/all?paymentStatus=pending`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch payment approvals');
                }

                const data = await response.json();
                const orders = data.orders || [];

                let html = '';
                orders.forEach((order, index) => {
                    const status = order.paymentStatus || 'pending';
                    const qualifiesForMembership = order.total >= 300;
                    const customerEmail = order.customer?.email || 'N/A';
                    const customerPhone = order.customer?.phone || 'N/A';

                    html += `
                        <tr>
                            <td><strong>${order.orderNumber}</strong></td>
                            <td>${new Date(order.createdAt).toLocaleString()}</td>
                            <td>
                                <div>${customerEmail}</div>
                                <small style="color: #999;">${customerPhone}</small>
                            </td>
                            <td><strong style="color: #FFFFFF;">R ${(order.total || 0).toFixed(2)}</strong></td>
                            <td>
                                <button class="action-btn view-btn" onclick="viewPaymentProof('${order.orderNumber}')">
                                    View POP
                                </button>
                            </td>
                            <td>
                                ${qualifiesForMembership ?
                                    '<span class="status-badge status-approved">✓ Qualifies</span>' :
                                    '<span class="status-badge">No</span>'
                                }
                            </td>
                            <td>
                                <span class="status-badge status-${status}">${status.toUpperCase()}</span>
                            </td>
                            <td>
                                ${status === 'pending' ? `
                                    <button class="action-btn approve-btn" onclick="quickApprove('${order.orderNumber}')">Approve</button>
                                    <button class="action-btn reject-btn" onclick="quickReject('${order.orderNumber}')">Reject</button>
                                ` : `
                                    <button class="action-btn view-btn" onclick="viewPaymentDetails('${order.orderNumber}')">Details</button>
                                `}
                            </td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html || '<tr><td colspan="8" style="text-align: center; color: #999;">No payment approvals pending</td></tr>';
            } catch (error) {
                console.error('Load payments error:', error);
                tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #f87171;">Error loading payment approvals from database</td></tr>';
            }
        }
        
        // REMOVED: localStorage-based loadVouchers() function
        // Using MongoDB API-based loadVouchers() at line 5389 instead
        
        async function loadOrders() {
            const tbody = document.getElementById('ordersList');

            try {
                const token = sessionStorage.getItem('adminToken');
                if (!token) {
                    tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #999;">Please login to view orders</td></tr>';
                    return;
                }

                const response = await fetch(`${API_URL}/orders/all`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch orders');
                }

                const data = await response.json();
                const orders = data.orders || [];

                let html = '';
                orders.forEach((order, index) => {
                    const customerName = `${order.customer?.firstName || ''} ${order.customer?.lastName || ''}`.trim() || 'Guest';
                    const hasPOP = order.payment?.proofOfPayment?.url ? true : false;
                    const popUrl = order.payment?.proofOfPayment?.url || '';
                    const fullPopUrl = popUrl.startsWith('/') || popUrl.startsWith('http') ? popUrl : '/uploads/' + popUrl;
                    const popIndicator = hasPOP ?
                        `<span style="color: #10b981; cursor: pointer;" onclick="event.stopPropagation(); viewProofModal('${fullPopUrl}')"><i class="fas fa-paperclip"></i> View POP</span>` :
                        `<span style="color: #6b7280;">No POP</span>`;

                    html += `
                        <tr>
                            <td><strong>${order.orderNumber || 'BMH' + index}</strong></td>
                            <td>${new Date(order.createdAt).toLocaleDateString()}</td>
                            <td>${customerName}</td>
                            <td>${order.items?.length || 0} items</td>
                            <td><strong>R ${(order.total || 0).toFixed(2)}</strong></td>
                            <td>
                                <span class="status-badge status-${order.payment?.status || 'pending'}">
                                    ${(order.payment?.status || 'pending').toUpperCase()}
                                </span>
                                <br>${popIndicator}
                            </td>
                            <td>
                                <span class="status-badge status-${order.status || 'pending'}">
                                    ${(order.status || 'pending').toUpperCase()}
                                </span>
                            </td>
                            <td>
                                <button class="action-btn view-btn" onclick='viewOrderDetails(${JSON.stringify(order).replace(/'/g, "&#39;")})'>Manage</button>
                            </td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html || '<tr><td colspan="8" style="text-align: center; color: #999;">No orders found</td></tr>';
            } catch (error) {
                console.error('Load orders error:', error);
                tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #f87171;">Error loading orders from database</td></tr>';
            }
        }
        
        function viewOrderDetails(order) {
            const details = document.getElementById('paymentDetails');
            const hasPOP = order.payment?.proofOfPayment?.url;

            // Hide localStorage POP buttons - this is for MongoDB orders
            const localStorageButtons = document.getElementById('localStoragePOPButtons');
            if (localStorageButtons) localStorageButtons.style.display = 'none';

            details.innerHTML = `
                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Order Details</h3>
                    <p><strong>Order Number:</strong> ${order.orderNumber}</p>
                    <p><strong>Order ID:</strong> ${order._id}</p>
                    <p><strong>Date:</strong> ${new Date(order.createdAt).toLocaleString()}</p>
                    <p><strong>Total Amount:</strong> <span style="color: #FFFFFF; font-size: 1.3rem;">R${(order.total || 0).toFixed(2)}</span></p>
                </div>

                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Customer Information</h3>
                    <p><strong>Name:</strong> ${order.customer?.firstName} ${order.customer?.lastName}</p>
                    <p><strong>Email:</strong> ${order.customer?.email || 'N/A'}</p>
                    <p><strong>Phone:</strong> ${order.customer?.phone || 'N/A'}</p>
                </div>

                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Order Items</h3>
                    ${order.items?.map(item =>
                        `<p>• ${item.name} x ${item.quantity} = R${(item.price * item.quantity).toFixed(2)}</p>`
                    ).join('') || '<p>No items data</p>'}
                    <p style="margin-top: 15px;"><strong>Subtotal:</strong> R${(order.subtotal || 0).toFixed(2)}</p>
                    <p><strong>Shipping:</strong> R${(order.shipping?.cost || 0).toFixed(2)}</p>
                    <p style="font-size: 1.2rem; color: #FFFFFF;"><strong>Total:</strong> R${(order.total || 0).toFixed(2)}</p>
                </div>

                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Payment Information</h3>
                    <p><strong>Method:</strong> ${(order.payment?.method || 'N/A').toUpperCase()}</p>
                    <p><strong>Status:</strong> <span class="status-badge status-${order.payment?.status || 'pending'}">${(order.payment?.status || 'pending').toUpperCase()}</span></p>

                    ${hasPOP ? `
                        ${(() => {
                            const popUrl = order.payment.proofOfPayment.url;
                            const fullUrl = popUrl.startsWith('/') || popUrl.startsWith('http') ? popUrl : '/uploads/' + popUrl;
                            return `<div style="margin-top: 15px; padding: 15px; background: rgba(16, 185, 129, 0.1); border: 2px solid #10b981; border-radius: 8px; cursor: pointer;" onclick="viewProofModal('${fullUrl}')">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                <h4 style="color: #10b981; margin: 0;"><i class="fas fa-paperclip"></i> Proof of Payment Uploaded</h4>
                                <span style="background: #10b981; color: white; padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 600;"><i class="fas fa-eye"></i> View</span>
                            </div>
                            <p><strong>File:</strong> ${popUrl.split('/').pop()}</p>`;
                        })()}
                            <p><strong>Uploaded:</strong> ${order.payment.proofOfPayment.uploadedAt ? new Date(order.payment.proofOfPayment.uploadedAt).toLocaleString() : 'N/A'}</p>
                            <p><strong>Verified:</strong> ${order.payment.proofOfPayment.verified ?
                                '<span style="color: #10b981;">✓ Yes</span>' :
                                '<span style="color: #f59e0b;">⏳ Pending</span>'}</p>
                            ${order.payment.proofOfPayment.verified && order.payment.proofOfPayment.verifiedAt ?
                                `<p><strong>Verified At:</strong> ${new Date(order.payment.proofOfPayment.verifiedAt).toLocaleString()}</p>` : ''}
                        </div>
                    ` : `
                        <div style="margin-top: 15px; padding: 15px; background: rgba(107, 114, 128, 0.1); border: 2px solid #6b7280; border-radius: 8px;">
                            <p style="color: #6b7280;">No proof of payment uploaded yet</p>
                        </div>
                    `}
                </div>

                ${(order.payment?.method === 'eft' || order.payment?.method === 'bitcoin') && hasPOP && !order.payment.proofOfPayment.verified ? `
                    <div style="display: flex; gap: 10px; margin-top: 20px;">
                        <button onclick="approvePayment('${order._id}')" style="flex: 1; padding: 15px; background: #2a2a2a; color: white; border: 2px solid #FFFFFF; border-radius: 8px; font-size: 1.1rem; font-weight: bold; cursor: pointer;">
                            Approve Payment
                        </button>
                        <button onclick="rejectPayment('${order._id}')" style="flex: 1; padding: 15px; background: #1a1a1a; color: white; border: 2px solid #FFFFFF; border-radius: 8px; font-size: 1.1rem; font-weight: bold; cursor: pointer;">
                            Reject Payment
                        </button>
                    </div>
                ` : ''}
            `;

            document.getElementById('paymentModal').style.display = 'flex';
        }

        function viewPaymentProof(index) {
            const pops = JSON.parse(localStorage.getItem('bmh_pops') || '[]');
            const pop = pops[index];
            currentPaymentIndex = index;

            // Show localStorage POP buttons - this is for localStorage POPs
            const localStorageButtons = document.getElementById('localStoragePOPButtons');
            if (localStorageButtons) localStorageButtons.style.display = 'flex';

            const details = document.getElementById('paymentDetails');
            details.innerHTML = `
                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Order Details</h3>
                    <p><strong>Order Number:</strong> ${pop.orderNumber}</p>
                    <p><strong>Date:</strong> ${new Date(pop.timestamp).toLocaleString()}</p>
                    <p><strong>Total Amount:</strong> <span style="color: #FFFFFF; font-size: 1.3rem;">R${pop.orderTotal}</span></p>
                </div>
                
                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Customer Information</h3>
                    <p><strong>Email:</strong> ${pop.email}</p>
                    <p><strong>Phone:</strong> ${pop.phone}</p>
                </div>
                
                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Order Items</h3>
                    ${pop.items?.map(item => 
                        `<p>• ${item.name} x ${item.quantity} = R${item.price * item.quantity}
                        ${item.friendMembership ? '<span class="status-badge status-approved">+Friend Voucher</span>' : ''}</p>`
                    ).join('') || '<p>No items data</p>'}
                </div>
                
                <div style="padding: 20px; background: #333; border-radius: 10px; margin-bottom: 20px;">
                    <h3 style="color: #FFFFFF; margin-bottom: 15px;">Proof of Payment</h3>
                    <p><strong>File:</strong> ${pop.fileName}</p>
                    <p style="color: #999; margin-top: 10px;">
                        [Proof of payment image would be displayed here]
                    </p>
                </div>
                
                <div style="padding: 20px; background: ${pop.orderTotal >= 300 ? 'rgba(16, 185, 129, 0.1)' : 'rgba(107, 114, 128, 0.1)'}; border: 2px solid ${pop.orderTotal >= 300 ? '#FFFFFF' : '#6b7280'}; border-radius: 10px;">
                    <h3 style="color: ${pop.orderTotal >= 300 ? '#FFFFFF' : '#6b7280'}; margin-bottom: 10px;">
                        ${pop.orderTotal >= 300 ? '✓ MEMBERSHIP ELIGIBLE' : '✗ Not Eligible for Membership'}
                    </h3>
                    <p>${pop.orderTotal >= 300 ? 
                        'This order qualifies for Lifestyle Membership (R300+ purchase). Membership will be activated upon payment approval.' : 
                        'Order amount is below R300 threshold for membership.'
                    }</p>
                    ${pop.items?.some(i => i.friendMembership) ? 
                        '<p style="margin-top: 10px; color: #FFFFFF;">🎁 Includes Friend Membership Voucher - will be generated upon approval</p>' : ''
                    }
                </div>
            `;
            
            document.getElementById('paymentModal').style.display = 'flex';
        }
        
        async function approvePayment(orderId) {
            showAdminConfirm('Approve Payment', 'Approve this payment and update order status to processing?', async () => {
                try {
                    const token = sessionStorage.getItem('adminToken');
                    if (!token) {
                        showAdminToast('Authentication Required', 'Please login to approve payments', 'error');
                        return;
                    }

                    const response = await fetch(`${API_URL}/orders/${orderId}/approve-payment`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        showAdminToast('Success', 'Payment approved successfully!', 'success');
                        document.getElementById('paymentModal').style.display = 'none';
                        loadOrders();
                    } else {
                        showAdminToast('Error', `Failed to approve payment: ${data.message}`, 'error');
                    }
                } catch (error) {
                    console.error('Approve payment error:', error);
                    showAdminToast('Error', 'Error approving payment. Please try again.', 'error');
                }
            });
        }

        async function rejectPayment(orderId) {
            showAdminPrompt('Reject Payment', 'Enter rejection reason:', async (reason) => {
                try {
                    const token = sessionStorage.getItem('adminToken');
                    if (!token) {
                        showAdminToast('Error', 'Please login to reject payments', 'error');
                        return;
                    }

                    const response = await fetch(`${API_URL}/orders/${orderId}/reject-payment`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ reason })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showAdminToast('Success', 'Payment rejected', 'success');
                        document.getElementById('paymentModal').style.display = 'none';
                        loadOrders();
                    } else {
                        showAdminToast('Error', `Failed to reject payment: ${data.message}`, 'error');
                    }
                } catch (error) {
                    console.error('Reject payment error:', error);
                    showAdminToast('Error', 'Error rejecting payment. Please try again.', 'error');
                }
            });
        }

        async function quickApprove(orderNumber) {
            try {
                const token = sessionStorage.getItem('adminToken');
                if (!token) {
                    showAdminToast('Authentication Required', 'Please login to approve payments', 'error');
                    return;
                }

                const response = await fetch(`${API_URL}/orders/${orderNumber}/approve`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    const error = await response.json();
                    showAdminToast('Error', `Failed to approve payment: ${error.message}`, 'error');
                    return;
                }

                const data = await response.json();
                showAdminToast('Success', 'Payment approved successfully!', 'success');
                loadDashboard();
            } catch (error) {
                console.error('Approve payment error:', error);
                showAdminToast('Error', 'Error approving payment. Please try again.', 'error');
            }
        }
        
        async function quickReject(orderNumber) {
            showAdminPrompt(
                'Reject Payment',
                'Please provide a reason for rejection:',
                async (reason) => {
                    try {
                        const token = sessionStorage.getItem('adminToken');
                        if (!token) {
                            showAdminToast('Authentication Required', 'Please login to reject payments', 'error');
                            return;
                        }

                        const response = await fetch(`${API_URL}/orders/${orderNumber}/reject`, {
                            method: 'POST',
                            headers: {
                                'Authorization': `Bearer ${token}`,
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ reason })
                        });

                        if (!response.ok) {
                            const error = await response.json();
                            showAdminToast('Error', `Failed to reject payment: ${error.message}`, 'error');
                            return;
                        }

                        showAdminToast('Success', 'Payment rejected', 'success');
                        loadDashboard();
                    } catch (error) {
                        console.error('Reject payment error:', error);
                        showAdminToast('Error', 'Error rejecting payment. Please try again.', 'error');
                    }
                }
            );
        }
        
        // Note: approvePayment(orderId) and rejectPayment(orderId) are defined above for MongoDB orders
        // For localStorage-based POPs, use quickApprove/quickReject with currentPaymentIndex
        
