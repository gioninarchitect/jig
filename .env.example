# ──────────────────────────────────────────────
# PureGro Premium Cannabis Care - B2B Wholesale Portal
# Copy to .env and fill in real values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/puregro

# OTP Email (SMTP)
SMTP_HOST=mail.cleva-ai.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=puregro@cleva-ai.co.za
SMTP_PASS=your_password_here
SMTP_FROM="PureGro Premium Cannabis Care <puregro@cleva-ai.co.za>"

# Auth
JWT_SECRET=change_me_to_random_64_char_string
JWT_EXPIRES_IN=7d

# Admin (comma-separated emails with admin access)
ADMIN_EMAILS=puregro@cleva-ai.co.za

# CORS (set to frontend domain in production)
CORS_ORIGIN=https://puregro.cleva-ai.co.za

# App
PORT=3002
NODE_ENV=development

# JIGPOS POS API (MDC source of truth for product catalog)
POS_API_URL=http://127.0.0.1:3004

# PureGro Company Details (for invoices)
PUREGRO_COMPANY_NAME=PureGro Premium Cannabis Care (Pty) Ltd
PUREGRO_COMPANY_REG=2024/XXXXXX/07
PUREGRO_COMPANY_VAT=4XXXXXXXXX
PUREGRO_COMPANY_ADDRESS=Johannesburg, South Africa
PUREGRO_COMPANY_EMAIL=puregro@cleva-ai.co.za
PUREGRO_COMPANY_PHONE=+27 XX XXX XXXX

# Chat Bot (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Banking Details (for EFT invoices)
PUREGRO_BANK_NAME=First National Bank
PUREGRO_BANK_ACCOUNT_NAME=PureGro Premium Cannabis Care (Pty) Ltd
PUREGRO_BANK_ACCOUNT_NUMBER=XXXXXXXXXX
PUREGRO_BANK_BRANCH_CODE=XXXXXX
PUREGRO_BANK_REFERENCE=Use your PO number as reference
