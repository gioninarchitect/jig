# ──────────────────────────────────────────────
# JIG Craft Cannabis - Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jig

# OTP Email (SMTP)
SMTP_HOST=mail.cleva-ai.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=otp@cleva-ai.co.za
SMTP_PASS=your_password_here
SMTP_FROM="JIG Craft Cannabis <otp@cleva-ai.co.za>"

# Auth
JWT_SECRET=change_me_to_random_64_char_string
JWT_EXPIRES_IN=7d

# Admin (comma-separated emails with admin access)
ADMIN_EMAILS=admin@jig.co.za

# CORS (set to frontend domain in production)
CORS_ORIGIN=https://jig.cleva-ai.co.za

# App
PORT=3002
NODE_ENV=development

# JIG Company Details (for invoices)
JIG_COMPANY_NAME=JIG Craft Cannabis (Pty) Ltd
JIG_COMPANY_REG=2024/XXXXXX/07
JIG_COMPANY_VAT=4XXXXXXXXX
JIG_COMPANY_ADDRESS=Johannesburg, South Africa
JIG_COMPANY_EMAIL=admin@cleva-ai.co.za
JIG_COMPANY_PHONE=+27 XX XXX XXXX

# Chat Bot (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Banking Details (for EFT invoices)
JIG_BANK_NAME=First National Bank
JIG_BANK_ACCOUNT_NAME=JIG Craft Cannabis (Pty) Ltd
JIG_BANK_ACCOUNT_NUMBER=XXXXXXXXXX
JIG_BANK_BRANCH_CODE=XXXXXX
JIG_BANK_REFERENCE=Use your PO number as reference
