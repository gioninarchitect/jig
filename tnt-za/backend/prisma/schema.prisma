// ── Cultivation inventory / stock (Loraine — replaces the paper logs) ──────────
// One generic model covers all her paper shapes: per-product chemical logs, the
// substrate/consumables/hygiene stock sheets, and the chemical batch+expiry register.
// balance is auto-maintained = running sum of movements (never hand-calculated).
model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  category     String   // CHEMICAL | SUBSTRATE | CONSUMABLE | HYGIENE
  unit         String   @default("unit")  // L · ml · kg · g · unit · bag
  balance      Float    @default(0)       // current on-hand (auto-maintained from movements)
  reorderLevel Float?                      // low-stock alert threshold
  location     String?  @default("Cultivation")
  active       Boolean  @default(true)
  facilityId   String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  movements    InventoryMovement[]

  @@unique([tenantId, category, name])
  @@index([tenantId])
  @@index([category])
}

model InventoryMovement {
  id             String        @id @default(uuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  date           DateTime      @default(now())
  type           String        // IN | OUT | ADJUST
  quantity       Float         // entered magnitude (always positive; sign derived from type)
  balanceAfter   Float         // running balance after this movement (recomputed on edit)
  productIn      String?       // "Product In" column — supplier / PO / source ref
  batchNumber    String?       // chemical register — batch of the stock received
  expiryDate     DateTime?     // chemical register — drives expiry alerts
  comment        String?
  source         String        @default("MANUAL")  // MANUAL | CHEMICAL_APPLICATION
  activityId     String?       // links to a CultivationActivity when auto-deducted
  recordedById   String
  recordedByName String?
  tenantId       String
  createdAt      DateTime      @default(now())

  @@index([tenantId])
  @@index([itemId])
  @@index([expiryDate])
}

// SOP 4-FAC-2 · Temperature & Humidity Daily Check
model EnvReading {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  zone      String   // CLONE_ROOM | GREENHOUSE
  slot      String   // 08:00 | 11:50 | 16:50
  temp      Float
  rh        Float
  strainId  String?
  batchNo   String?
  checkedBy String
  checkedByName String?
  signedAt  DateTime @default(now())
  tenantId  String
  createdAt DateTime @default(now())
  ticketId  String?

  @@index([tenantId])
  @@index([zone, date])
  @@index([ticketId])
}

// SOP 3-CUL-012 · Harvest Request Form + Check Sheet
model HarvestRequest {
  id                  String   @id @default(uuid())
  batchNo             String
  strainId            String
  floweringStartDate  DateTime
  batchSizePlants     Int
  greenhouse          String
  bay                 String
  reasonForHarvest    String
  requestedBy         String
  requestedByName     String?
  requestedDate       DateTime
  status              String   @default("REQUESTED") // REQUESTED | APPROVED | DECLINED | COMPLETED
  checklistAnswers    Json?    // boolean[]
  dryingRoomAllocated String?

  // Potential yield — estimated before harvest
  expectedYieldPerPlantG Int?      // grams per plant, based on strain baseline × grower factor
  expectedYieldKg        Decimal?  // total potential (auto = plants × gPerPlant / 1000)
  expectedHarvestDate    DateTime?

  // Actual yield — captured after harvest for variance reporting
  actualYieldKg          Decimal?
  actualHarvestDate      DateTime?
  yieldVariancePct       Float?   // (actual - expected) / expected × 100

  qamApprovedBy       String?
  qamApprovedByName   String?
  hocApprovedBy       String?
  hocApprovedByName   String?
  approvedAt          DateTime?
  tenantId            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

