{
  "name": "JIG - Churn Prevention (Weekly)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "cron-weekly-monday",
      "name": "Weekly Monday 9am Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://jig.cleva-ai.co.za/api/v1/n8n/data/clients",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-clients",
      "name": "Fetch All Clients",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "calc-inactive-days",
              "name": "daysSinceLastOrder",
              "value": "={{ $json.lastOrderDate ? Math.floor((Date.now() - new Date($json.lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)) : 999 }}",
              "type": "number"
            },
            {
              "id": "keep-client-name",
              "name": "clientName",
              "value": "={{ $json.clientName }}",
              "type": "string"
            },
            {
              "id": "keep-business",
              "name": "businessName",
              "value": "={{ $json.businessName }}",
              "type": "string"
            },
            {
              "id": "keep-tier",
              "name": "tier",
              "value": "={{ $json.tier }}",
              "type": "string"
            },
            {
              "id": "keep-total-revenue",
              "name": "totalRevenue",
              "value": "={{ $json.totalRevenue || 0 }}",
              "type": "number"
            },
            {
              "id": "keep-last-order",
              "name": "lastOrderDate",
              "value": "={{ $json.lastOrderDate || 'Never' }}",
              "type": "string"
            },
            {
              "id": "keep-churn-score",
              "name": "churnScore",
              "value": "={{ $json.churnScore || 0 }}",
              "type": "number"
            }
          ]
        }
      },
      "id": "calc-inactive",
      "name": "Calculate Inactivity",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-30-days",
              "leftValue": "={{ $json.daysSinceLastOrder }}",
              "rightValue": 30,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-inactive-30",
      "name": "30+ Days Inactive?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-60-days",
              "leftValue": "={{ $json.daysSinceLastOrder }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-critical-60",
      "name": "60+ Days (Critical)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=**CRITICAL CHURN RISK**\n\nClient: {{ $json.clientName }}\nBusiness: {{ $json.businessName }}\nTier: {{ $json.tier }}\nTotal Revenue: R{{ $json.totalRevenue }}\nLast Order: {{ $json.lastOrderDate }}\nDays Inactive: {{ $json.daysSinceLastOrder }}\nChurn Score: {{ $json.churnScore }}/100\n\nThis client has been inactive for 60+ days. Immediate personal outreach recommended.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-critical-churn",
      "name": "Critical Churn Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 100],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIALS_ID",
          "name": "JIG Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=**Re-engagement Needed**\n\nClient: {{ $json.clientName }}\nBusiness: {{ $json.businessName }}\nTier: {{ $json.tier }}\nTotal Revenue: R{{ $json.totalRevenue }}\nLast Order: {{ $json.lastOrderDate }}\nDays Inactive: {{ $json.daysSinceLastOrder }}\nChurn Score: {{ $json.churnScore }}/100\n\nConsider offering a special deal or checking in on this client.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-reengage",
      "name": "Send Re-engagement Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 300],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIALS_ID",
          "name": "JIG Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Weekly Monday 9am Trigger": {
      "main": [
        [
          {
            "node": "Fetch All Clients",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch All Clients": {
      "main": [
        [
          {
            "node": "Calculate Inactivity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Inactivity": {
      "main": [
        [
          {
            "node": "30+ Days Inactive?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "30+ Days Inactive?": {
      "main": [
        [
          {
            "node": "60+ Days (Critical)?",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "60+ Days (Critical)?": {
      "main": [
        [
          {
            "node": "Critical Churn Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Re-engagement Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "JIG"
    },
    {
      "name": "Churn"
    }
  ],
  "triggerCount": 1,
  "versionId": "1"
}