{
  "name": "JIG - Order Lifecycle",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jig/order-confirmed",
        "options": {
          "responseMode": "onReceived",
          "responseData": "allEntries"
        },
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "X-N8N-API-KEY",
          "value": "={{$env.N8N_API_KEY}}"
        }
      },
      "id": "webhook-order-confirmed",
      "name": "Order Confirmed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "jig-order-confirmed"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-order-id",
              "name": "orderId",
              "value": "={{ $json.body.orderId }}",
              "type": "string"
            },
            {
              "id": "set-client-name",
              "name": "clientName",
              "value": "={{ $json.body.clientName }}",
              "type": "string"
            },
            {
              "id": "set-total",
              "name": "totalAmount",
              "value": "={{ $json.body.totalAmount }}",
              "type": "number"
            },
            {
              "id": "set-client-id",
              "name": "clientId",
              "value": "={{ $json.body.clientId }}",
              "type": "string"
            },
            {
              "id": "set-confirmed-at",
              "name": "confirmedAt",
              "value": "={{ $json.body.confirmedAt || $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-order-data",
      "name": "Extract Order Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=**New Invoice - Order #{{ $json.orderId }}**\n\nClient: {{ $json.clientName }}\nAmount: R{{ $json.totalAmount }}\nDate: {{ $json.confirmedAt }}\n\nPayment due within 7 days.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-invoice",
      "name": "Send Invoice Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [680, 300],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIALS_ID",
          "name": "JIG Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "days"
      },
      "id": "wait-3-days",
      "name": "Wait 3 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://jig.cleva-ai.co.za/api/v1/n8n/data/orders/{{ $('Extract Order Data').item.json.orderId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "check-payment",
      "name": "Check Payment Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-unpaid",
              "leftValue": "={{ $json.paymentStatus }}",
              "rightValue": "paid",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-unpaid",
      "name": "Is Unpaid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=**Payment Reminder - Order #{{ $('Extract Order Data').item.json.orderId }}**\n\nClient: {{ $('Extract Order Data').item.json.clientName }}\nAmount Due: R{{ $('Extract Order Data').item.json.totalAmount }}\n\nThis order was confirmed 3 days ago and remains unpaid. Please follow up.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-reminder",
      "name": "Send Payment Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1560, 200],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIALS_ID",
          "name": "JIG Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "amount": 4,
        "unit": "days"
      },
      "id": "wait-4-days",
      "name": "Wait 4 More Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=**OVERDUE - Order #{{ $('Extract Order Data').item.json.orderId }}**\n\nClient: {{ $('Extract Order Data').item.json.clientName }}\nAmount: R{{ $('Extract Order Data').item.json.totalAmount }}\n\nThis order is now 7 days overdue. Immediate action required.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-overdue",
      "name": "Send Overdue Notice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2000, 200],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIALS_ID",
          "name": "JIG Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Order Confirmed Webhook": {
      "main": [
        [
          {
            "node": "Extract Order Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Order Data": {
      "main": [
        [
          {
            "node": "Send Invoice Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Invoice Notification": {
      "main": [
        [
          {
            "node": "Wait 3 Days",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 3 Days": {
      "main": [
        [
          {
            "node": "Check Payment Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Payment Status": {
      "main": [
        [
          {
            "node": "Is Unpaid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Unpaid?": {
      "main": [
        [
          {
            "node": "Send Payment Reminder",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Send Payment Reminder": {
      "main": [
        [
          {
            "node": "Wait 4 More Days",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 4 More Days": {
      "main": [
        [
          {
            "node": "Send Overdue Notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "JIG"
    },
    {
      "name": "Orders"
    }
  ],
  "triggerCount": 1,
  "versionId": "1"
}