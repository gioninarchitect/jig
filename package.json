{
  "name": "origin",
  "version": "1.0.0",
  "description": "Origin by ILCO Farming - B2B Wholesale Platform",
  "private": true,
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:frontend": "vite build",
    "build:seed": "tsc -p tsconfig.seed.json",
    "clean": "rm -rf dist/server dist/seed",
    "build": "npm run clean && npm run build:server && npm run build:frontend && npm run build:seed",
    "start": "node dist/server/server/index.js",
    "dev:server": "ts-node --project tsconfig.server.json src/server/index.ts",
    "dev:frontend": "vite",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "seed": "node dist/seed/seed.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jest": "^30.2.0",
    "react": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@types/multer": "^2.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0"
  }
}
